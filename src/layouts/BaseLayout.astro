---
interface Props {
  title?: string;
}
import '../styles/global.css'
import { ThemeProvider } from '../../components/theme-provider';
const { title = 'Your Name — AI/ML Engineer' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+JP:wght@300;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <ThemeProvider attribute="class" defaultTheme="system" enableSystem>
      <slot />

      <!-- Global scroll animation observer -->
      <script>
        const els = document.querySelectorAll('.animate-on-scroll');
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
              }
            });
          },
          { threshold: 0.15 }
        );
        els.forEach((el) => observer.observe(el));
      </script>
    </ThemeProvider>
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
</style>
