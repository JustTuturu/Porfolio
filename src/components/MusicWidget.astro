---
---

<!-- Music widget — hidden by default -->
<div id="music-widget" 
  class="fixed top-12 right-0 z-[100] translate-x-[-10%] translate-y-5 opacity-0 transition-[opacity,transform] duration-300 pointer-events-none hidden" 
  role="dialog" 
  aria-label="Now playing widget" 
  aria-hidden="true">
  <div class="bg-[rgba(13,14,24,0.92)] backdrop-blur-[20px] border border-white/8 rounded-2xl p-5 w-80 flex flex-col gap-4">
    <div class="flex gap-3">
      <img id="music-art" src=""
       alt="Album artwork" 
       class="w-[52px] h-[52px] rounded-[6px] object-cover flex-shrink-0 bg-white/5" 
       style="display: none;" 
       width="52" 
       height="52" 
       loading="lazy"/>
      <div class="flex flex-col gap-1 overflow-hidden">
        <p id="music-song" 
          class="font-['Inter'] text-[0.9rem] font-semibold text-[var(--text-primary)] whitespace-nowrap overflow-hidden text-ellipsis" 
          aria-live="polite">Nyan~</p>
        <p id="music-artist" 
        class="font-['Inter'] text-[0.75rem] text-[var(--text-primary)]/45 whitespace-nowrap overflow-hidden text-ellipsis" 
        aria-live="polite"></p>
      </div>
    </div>

    <div class="flex justify-end">
      <a id="music-link" 
      href="#" target="_blank" 
      rel="noopener noreferrer" 
      class="font-['JetBrains_Mono'] text-[0.65rem] text-[#1DB954] no-underline tracking-[0.05em] opacity-70 transition-opacity duration-200 hover:opacity-100" 
      aria-label="Open in Spotify (opens in new tab)">
        Open in Spotify ↗
      </a>
    </div>

  </div>
</div>

<!-- Arrow key hint -->
<div id="music-hint" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[99] font-['JetBrains_Mono'] text-[0.6rem] tracking-[0.15em] text-[var(--text-primary)]/20 uppercase transition-opacity duration-300 pointer-events-none" role="status" aria-live="polite">
  <span>↑ now playing</span>
</div>

<script is:inline>
  var DISCORD_USER_ID = '328694743057825792';

  document.addEventListener('DOMContentLoaded', function() {
    var widget = document.getElementById('music-widget');
    var hint = document.getElementById('music-hint');
    var songEl = document.getElementById('music-song');
    var artistEl = document.getElementById('music-artist');
    var artEl = document.getElementById('music-art');
    var linkEl = document.getElementById('music-link');

    var isOpen = false;
    var spotify = null;

    var navMusicBtn = document.getElementById('music-btn');
    if (navMusicBtn) {
      navMusicBtn.addEventListener('click', function(e) {
        e.preventDefault();
        isOpen ? closeWidget() : openWidget();
      });
    }

    function fetchSpotify() {
      fetch('https://api.lanyard.rest/v1/users/' + DISCORD_USER_ID)
        .then(function(res) { return res.json(); })
        .then(function(data) {
          spotify = data.data && data.data.spotify ? data.data.spotify : null;
          updateWidget();
        })
        .catch(function() { spotify = null; });
    }

    function updateWidget() {
      if (!spotify) {
        if (songEl) songEl.textContent = 'Nyan~';
        if (artistEl) artistEl.textContent = '';
        if (artEl) { artEl.src = ''; artEl.style.display = 'none'; }
        if (linkEl) {
          linkEl.href = 'https://open.spotify.com/playlist/4cgl6peqciW7mGIi7fPwsZ';
          linkEl.target = '_blank';
        }
        return;
      }
      if (songEl) songEl.textContent = spotify.song;
      if (artistEl) artistEl.textContent = spotify.artist;
      if (artEl) { artEl.src = spotify.album_art_url; artEl.style.display = 'block'; }
      if (linkEl) {
        linkEl.href = spotify.track_id
          ? 'https://open.spotify.com/track/' + spotify.track_id.split(':').pop()
          : 'https://open.spotify.com/playlist/4cgl6peqciW7mGIi7fPwsZ';
      }
    }

    function openWidget() {
      isOpen = true;
      widget.classList.remove('hidden');
      widget.classList.add('visible');
      widget.setAttribute('aria-hidden', 'false');
      if (hint) hint.classList.add('hidden');
      fetchSpotify();
    }

    function closeWidget() {
      isOpen = false;
      widget.classList.remove('visible');
      widget.classList.add('hidden');
      widget.setAttribute('aria-hidden', 'true');
      if (hint) hint.classList.remove('hidden');
    }

    window.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowUp' && !isOpen) { e.preventDefault(); openWidget(); }
      if (e.key === 'Escape' && isOpen) { closeWidget(); }
      if (e.key === 'ArrowDown' && isOpen) { e.preventDefault(); closeWidget(); }
    });

    document.addEventListener('click', function(e) {
      var clickedInsideWidget = widget.contains(e.target);
      var clickedNavBtn = navMusicBtn && navMusicBtn.contains(e.target);
      if (isOpen && !clickedInsideWidget && !clickedNavBtn) closeWidget();
    });

    fetchSpotify();
    setInterval(fetchSpotify, 10000);
  });
</script>

<style>
  #music-widget.visible {
    opacity: 1;
    transform: translateX(-10%) translateY(0);
    pointer-events: auto;
  }

  #music-widget.hidden {
    opacity: 0;
    pointer-events: none;
  }

  #music-hint.hidden { opacity: 0; }
</style>
