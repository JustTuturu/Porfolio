---
import { PROJECTS } from '../data/index';

const featured = PROJECTS.find((p) => p.featured);
const others = PROJECTS.filter((p) => !p.featured);
---

<section id="projects" class="section-padding" aria-labelledby="projects-heading">
  <div class="content-container">

    <span class="section-label animate-on-scroll" id="projects-heading">// projects</span>
    <h2 class="section-heading animate-on-scroll">Featured Projects</h2>

    <div class="projects-stack">

      <!-- Featured — full width horizontal card -->
      {featured && (
        <article
          class="project-card project-featured"
          style={`--card-accent: ${featured.categoryColor};`}
          aria-label={`Featured project: ${featured.title}`}
        >
          <div class="featured-inner">
            <!-- Left: visual block -->
            <div class="featured-visual">
              <div class="featured-icon-shell">
                <span class="featured-icon">{featured.category.slice(0, 2)}</span>
              </div>
            </div>

            <!-- Right: content -->
            <div class="featured-body">
              <div class="flex items-center gap-3 mb-3">
                <span
                  class="font-['Raleway'] text-[0.6875rem] font-medium tracking-[0.18em] uppercase"
                  style={`color: ${featured.categoryColor};`}
                >
                  {featured.category}
                </span>
                <span class="w-1 h-1 rounded-full bg-(--text-primary)/15"></span>
                <span class="text-[0.75rem] text-(--text-primary)/25">
                  {featured.label}
                </span>
              </div>

              <h3 class="font-['Raleway'] text-[1.5rem] sm:text-[1.75rem] font-bold leading-[1.2] text-(--text-primary) tracking-[-0.015em] mb-3">
                {featured.title}
              </h3>

              <p class="text-[0.9375rem] leading-[1.65] text-(--text-primary)/45 mb-5 max-w-xl">
                {featured.description}
              </p>

              <div class="flex flex-wrap gap-2 mb-5">
                {featured.metrics.map((m) => (
                  <span class="metric-badge">{m}</span>
                ))}
              </div>

              <div class="flex flex-wrap gap-2 mb-6">
                {featured.tech.map((t) => (
                  <span class="tech-tag">{t}</span>
                ))}
              </div>

              <div class="flex flex-wrap gap-6">
                {featured.github && (
                  <a href={featured.github} target="_blank" rel="noopener noreferrer" class="link-arrow">
                    View Code
                  </a>
                )}
                {featured.demo && (
                  <a href={featured.demo} target="_blank" rel="noopener noreferrer" class="link-arrow">
                    Live Demo
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      )}

      <!-- Other projects — 2 equal columns -->
      <div class="project-subgrid">
        {others.map((project) => (
          <article
            class="project-card"
            style={`--card-accent: ${project.categoryColor};`}
            aria-label={`Project: ${project.title}`}
          >
            <div class="flex items-center gap-3 mb-4">
              <span
                class="font-['Raleway'] text-[0.6875rem] font-medium tracking-[0.18em] uppercase"
                style={`color: ${project.categoryColor};`}
              >
                {project.category}
              </span>
              <span class="w-1 h-1 rounded-full bg-(--text-primary)/15"></span>
              <span class="text-[0.75rem] text-(--text-primary)/22 truncate max-w-25">
                {project.label}
              </span>
            </div>

            <h4 class="font-['Raleway'] text-[1.125rem] font-bold leading-[1.3] text-(--text-primary) tracking-[-0.005em] mb-2">
              {project.title}
            </h4>

            <p class="text-[0.875rem] leading-[1.6] text-(--text-primary)/42 mb-4">
              {project.description}
            </p>

            {project.metrics.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-4">
                {project.metrics.map((m) => (
                  <span class="metric-badge">{m}</span>
                ))}
              </div>
            )}

            <div class="flex flex-wrap gap-2 mb-5">
              {project.tech.map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>

            {project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="link-arrow">
                View Code
              </a>
            )}
          </article>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .projects-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .featured-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .featured-visual {
    display: flex;
    align-items: flex-start;
  }

  .featured-icon-shell {
    width: 4rem;
    height: 4rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .featured-icon {
    font-family: 'Raleway', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--card-accent, var(--accent-pink));
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .featured-body {
    flex: 1;
    min-width: 0;
  }

  .project-subgrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .featured-inner {
      flex-direction: row;
      align-items: flex-start;
      gap: 2rem;
    }

    .featured-icon-shell {
      width: 5rem;
      height: 5rem;
    }

    .project-subgrid {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .projects-stack {
      gap: 1.5rem;
    }

    .project-subgrid {
      gap: 1.5rem;
    }
  }
</style>
