---
import { META } from '../data/index';
---

<section id="contact" class="section-padding">
  <div class="content-container">
    <!-- Section label -->
    <span class="section-label animate-on-scroll">// CONTACT</span>
    
    <!-- Section heading -->
    <h2 class="section-heading animate-on-scroll">
      Get In Touch
    </h2>

    <!-- Contact info -->
    <div class="card animate-on-scroll delay-1">
      <p class="body-text mb-6">I'm currently open to internship opportunities and collaborations. Feel free to reach out!</p>
      
      <div class="flex flex-col gap-3">
        <a href={`mailto:${META.email}`} class="mono-label hover:text-accent-pink transition-colors">
          Email: {META.email}
        </a>
        <a href={META.github} target="_blank" class="mono-label hover:text-accent-pink transition-colors">
          GitHub: {META.github}
        </a>
        <a href={META.linkedin} target="_blank" class="mono-label hover:text-accent-pink transition-colors">
          LinkedIn: {META.linkedin}
        </a>
      </div>
    </div>
  </div>
</section>
