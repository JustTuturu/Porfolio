---
import { PROJECTS } from '../data/index';

const featured = PROJECTS.find((p) => p.featured);
const others = PROJECTS.filter((p) => !p.featured);

// Helper: convert hex/rgba to rgb for CSS variables
function toRgb(hex: string): string {
  // Handle rgba(r,g,b,a) format
  const rgba = hex.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
  if (rgba) return `${rgba[1]}, ${rgba[2]}, ${rgba[3]}`;
  // Handle hex
  const h = hex.replace('#', '');
  const bigint = parseInt(h.length === 3 ? h.split('').map(c => c + c).join('') : h, 16);
  return `${(bigint >> 16) & 255}, ${(bigint >> 8) & 255}, ${bigint & 255}`;
}
---

<section id="projects" class="section-padding" aria-labelledby="projects-heading">
  <div class="content-container">

    <span class="section-label animate-on-scroll" id="projects-heading">// projects</span>
    <h2 class="section-heading animate-on-scroll">Featured Projects</h2>

    <div class="project-grid animate-on-scroll delay-1">

      <!-- Featured — large card -->
      {featured && (
        <article
          class="project-featured"
          style={`--card-accent: ${featured.categoryColor};`}
          aria-label={`Featured project: ${featured.title}`}
        >
          <div class="flex items-center justify-between mb-5">
            <span
              class="font-['JetBrains_Mono'] text-[0.6875rem] font-medium tracking-[0.18em] uppercase"
              style={`color: ${featured.categoryColor};`}
            >
              {featured.category}
            </span>
            <span class="text-[0.75rem] text-[var(--text-primary)]/25 truncate max-w-[140px]">
              {featured.label}
            </span>
          </div>

          <div class="space-y-3 flex-1">
            <h3 class="font-['Space_Grotesk'] text-[1.5rem] font-semibold leading-[1.25] text-[var(--text-primary)] tracking-[-0.01em]">
              {featured.title}
            </h3>
            <p class="text-[0.9375rem] leading-[1.7] text-[var(--text-primary)]/45">
              {featured.description}
            </p>
          </div>

          <div class="mt-6 flex flex-wrap gap-2">
            {featured.metrics.map((m) => (
              <span class="metric-badge">{m}</span>
            ))}
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            {featured.tech.map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>

          <div class="mt-7 flex flex-wrap gap-6">
            {featured.github && (
              <a href={featured.github} target="_blank" rel="noopener noreferrer" class="link-arrow">
                View Code
              </a>
            )}
            {featured.demo && (
              <a href={featured.demo} target="_blank" rel="noopener noreferrer" class="link-arrow">
                Live Demo
              </a>
            )}
          </div>

        </article>
      )}

      <!-- Other projects — compact cards -->
      {others.map((project, idx) => (
        <article
          class="project-card"
          style={`--card-accent: ${project.categoryColor};`}
          aria-label={`Project: ${project.title}`}
        >
          <div class="flex items-center justify-between mb-4">
            <span
              class="font-['JetBrains_Mono'] text-[0.6875rem] font-medium tracking-[0.18em] uppercase"
              style={`color: ${project.categoryColor};`}
            >
              {project.category}
            </span>
            <span class="text-[0.75rem] text-[var(--text-primary)]/22 truncate max-w-[100px]">
              {project.label}
            </span>
          </div>

          <div class="space-y-2 flex-1">
            <h4 class="font-['Space_Grotesk'] text-[1.125rem] font-semibold leading-[1.3] text-[var(--text-primary)] tracking-[-0.005em]">
              {project.title}
            </h4>
            <p class="text-[0.875rem] leading-[1.65] text-[var(--text-primary)]/42">
              {project.description}
            </p>
          </div>

          {project.metrics.length > 0 && (
            <p class="mt-4 flex flex-wrap gap-2">
              {project.metrics.map((m) => (
                <span class="metric-badge">{m}</span>
              ))}
            </p>
          )}

          <div class="mt-4 flex flex-wrap gap-2">
            {project.tech.map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>

          {project.github && (
            <a href={project.github} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block link-arrow">
              View Code
            </a>
          )}

        </article>
      ))}

    </div>
  </div>
</section>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: 1.45fr 1fr;
      gap: 1.25rem;
    }

    .project-featured {
      grid-row: span 2;
    }
  }

  @media (min-width: 1024px) {
    .project-grid {
      gap: 1.5rem;
    }
  }
</style>
