---
import { META } from "../data/index";
---

<section id="contact" class="section-padding" aria-labelledby="contact-heading">
    <div class="content-container">
        <span class="section-label animate-on-scroll" id="contact-heading">
            // contact
        </span>
        <h2 class="section-heading animate-on-scroll">Get In Touch</h2>

        <p
            class="type-body-large animate-on-scroll"
            style="max-width: 30rem; margin-bottom: 1.5rem;"
        >
            Open to internships and collaborations. Just say hi.
        </p>

        <!-- Contact links -->
        <div
            class="contact-list animate-on-scroll delay-1 flex flex-col items-stretch gap-0"
            aria-label="Contact links"
        >
            <a
                href={`mailto:${META.email}`}
                class="flex flex-col gap-1 py-4 no-underline transition-opacity duration-300 opacity-70 hover:opacity-100"
                aria-label={`Send email to ${META.email}`}
            >
                <span class="type-label-small uppercase text-(--accent-pink)">
                    Email
                </span>
                <span class="type-body-medium text-(--text-primary)">
                    {META.email}
                </span>
            </a>

            <div
                class="w-full h-px bg-(--glass-border)"
                role="separator"
                aria-hidden="true"
            ></div>

            <a
                href={META.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex flex-col gap-1 py-4 no-underline transition-opacity duration-300 opacity-70 hover:opacity-100"
                aria-label="Visit GitHub profile (opens in new tab)"
            >
                <span class="type-label-small uppercase text-(--accent-pink)">
                    GitHub
                </span>
                <span class="type-body-medium text-(--text-primary)">
                    @{META.github.split("/").pop()}
                </span>
            </a>

            <div
                class="w-full h-px bg-(--glass-border)"
                role="separator"
                aria-hidden="true"
            ></div>

            <a
                href={META.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="flex flex-col gap-1 py-4 no-underline transition-opacity duration-300 opacity-70 hover:opacity-100"
                aria-label="Visit LinkedIn profile (opens in new tab)"
            >
                <span class="type-label-small uppercase text-(--accent-pink)">
                    LinkedIn
                </span>
                <span class="type-body-medium text-(--text-primary)">
                    @{META.linkedin.split("/").pop()}
                </span>
            </a>
        </div>
    </div>
</section>
