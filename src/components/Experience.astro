---
import { EXPERIENCES } from '../data/index';
---

<section id="experience" class="section-padding">
  <div class="content-container">
    <!-- Section label -->
    <span class="section-label animate-on-scroll">// EXPERIENCE</span>
    
    <!-- Section heading -->
    <h2 class="section-heading animate-on-scroll">
      Experience
    </h2>

    <div class="space-y-6">
      {EXPERIENCES.map((exp, idx) => (
        <div class={`card animate-on-scroll delay-${Math.min((idx % 4) + 1, 4)} ${exp.seeking ? 'border-accent-orange glow-orange' : ''}`}>
          <div class="flex items-start justify-between mb-4">
            <div>
              <h3 class="card-title text-xl">{exp.company}</h3>
              <p class="mono-label mt-1">{exp.role}</p>
            </div>
            <div class="text-right">
              <p class="body-text text-sm">{exp.period}</p>
              <p class="mono-label text-xs uppercase">{exp.type}</p>
            </div>
          </div>

          {exp.achievements && exp.achievements.length > 0 && (
            <div class="mt-4">
              <h4 class="mono-label mb-2">Key Achievements</h4>
              <ul class="space-y-1">
                {exp.achievements.map((achievement) => (
                  <li class="body-text text-sm flex items-start gap-2">
                    <span class="text-accent-cyan mt-1">▸</span>
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {exp.tech && exp.tech.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-glass-border">
              {exp.tech.map((t) => (
                <span class="badge">{t}</span>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
