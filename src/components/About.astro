---
import { META } from '../data/index';
---

<section id="about" style="padding: 5rem 1.5rem;" aria-labelledby="about-heading">

  <div class="content-container">

    <span class="section-label animate-on-scroll" id="about-heading">// about</span>
    <h2 class="section-heading animate-on-scroll">About Me</h2>

    <div class="about-grid animate-on-scroll delay-1">

      <div class="bio">
        <p class="bio-text">
          I'm a passionate AI/ML engineer and computer science student
          deeply interested in building intelligent systems. With a strong
          foundation in deep learning, NLP, and computer vision,
          I'm driven to solve real-world problems using cutting-edge AI.
        </p>
        <p class="bio-text">
          Whether it's fine-tuning large language models, building RAG pipelines,
          or optimizing neural networks, I love pushing the boundaries of what's
          possible with AI. Currently seeking internship opportunities.
        </p>

        <!-- Buttons -->
        <div class="btn-row" role="list" aria-label="Quick links">
          <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="btn-primary" role="listitem" aria-label="View resume (opens in new tab)">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            Resume
          </a>
          <a href={`mailto:${META.email}`} target="_blank" rel="noopener noreferrer" class="btn-ghost" role="listitem" aria-label="Send email (opens in new tab)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            Mail
          </a>
          <a href={META.linkedin} target="_blank" rel="noopener noreferrer" class="btn-ghost" role="listitem" aria-label="Visit LinkedIn profile (opens in new tab)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <a href={META.twitter} target="_blank" rel="noopener noreferrer" class="btn-ghost" role="listitem" aria-label="Visit X profile (opens in new tab)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.736-8.835L1.254 2.25H8.08l4.259 5.63 5.905-5.63Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            X
          </a>
          <a href={META.github} target="_blank" rel="noopener noreferrer" class="btn-ghost" role="listitem" aria-label="Visit GitHub profile (opens in new tab)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
          </a>

        </div>
      </div>

      <div class="info-col">
        <div class="discord-card" aria-label="Discord status">
          <div class="discord-top">
            <span class="discord-label">// Discord</span>
            <span class="discord-status">
              <span class="discord-dot" aria-hidden="true"></span>
              <span id="discord-status-text">Offline</span>
            </span>

          </div>
          <p class="discord-user">suzu</p>
          <div class="discord-avatar-wrapper">
            <span class="discord-avatar-dot" aria-hidden="true"></span>
            <img class="discord-avatar" src="" alt="Discord avatar for {META.discord}" width="40" height="40" loading="lazy" />
          </div>
          <p class="discord-activity" id="discord-activity" aria-live="polite">no current activity</p>
          
        </div>

        <div class="info-divider" role="separator" aria-hidden="true"></div>

        <div class="info-block">
          <span class="info-key">Location</span>
          <span class="info-val">{META.location}</span>
        </div>

        <div class="info-divider" role="separator" aria-hidden="true"></div>

        <div class="info-block">
          <span class="info-key">Status</span>
          <span class="info-val status">
            <span class="status-dot" aria-hidden="true"></span>
            {META.available ? 'Available for internships' : 'Not available'}
          </span>
        </div>

      </div>
    </div>
  </div>
</section>

<script is:inline>
  var DISCORD_USER_ID = '328694743057825792';

  function fetchDiscordStatus() {
    fetch('https://api.lanyard.rest/v1/users/' + DISCORD_USER_ID)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (!data.success) return;

        var discord_status = data.data.discord_status;
        var activities = data.data.activities;
        var discord_user = data.data.discord_user;

        var dot = document.querySelector('.discord-dot');
        var statusText = document.getElementById('discord-status-text');
        var activityEl = document.getElementById('discord-activity');
        var avatarEl = document.querySelector('.discord-avatar');

        var colors = {
          online: '#57F287',
          idle: '#FEE75C',
          dnd: '#ED4245',
          offline: 'rgba(255,255,255,0.2)',
        };

        if (dot) dot.style.background = colors[discord_status] || colors.offline;
        if (statusText) statusText.textContent = discord_status === 'dnd' ? 'do not disturb' : discord_status;

        var activity = null;
        if (activities) {
          for (var i = 0; i < activities.length; i++) {
            if (activities[i].type === 0) {
              activity = activities[i];
              break;
            }
          }
        }
        if (activityEl) {
          activityEl.textContent = activity
            ? 'playing ' + activity.name
            : (activities && activities[0] ? activities[0].state : 'no current activity');
        }

        if (avatarEl && discord_user) {
          var avatarHash = discord_user.avatar;
          if (avatarHash) {
            var ext = avatarHash.indexOf('a_') === 0 ? 'gif' : 'webp';
            avatarEl.src = 'https://cdn.discordapp.com/avatars/' + DISCORD_USER_ID + '/' + avatarHash + '.' + ext + '?size=128';
          }
        }
      })
      .catch(function() {});
  }

  fetchDiscordStatus();
  setInterval(fetchDiscordStatus, 30000);
</script>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: start;
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bio-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    line-height: 1.8;
    color: rgba(240,232,224,0.55);
  }

  /* Buttons */
  .btn-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.1rem;
    background: var(--text-primary);
    color: var(--bg-base);
    border-radius: 999px;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .btn-primary:hover { opacity: 0.85; }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.1rem;
    background: transparent;
    color: var(--text-primary);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.3s ease, opacity 0.3s ease;
    opacity: 0.7;
  }

  .btn-ghost:hover {
    border-color: rgba(255,255,255,0.3);
    opacity: 1;
  }

  /* Discord card */
  .discord-card {
    padding: 0rem 0 0rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .discord-top {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.6rem;
    margin-bottom: 0.15rem;
  }

  .discord-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: rgba(240,232,224,0.3);
    text-transform: uppercase;
  }

  .discord-status {
    display: flex;
    gap: 0.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(240,232,224,0.4);
  }

  .discord-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    flex-shrink: 0;
    transition: background 0.3s ease;
  }

  .discord-user {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .discord-activity {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: rgba(240,232,224,0.3);
    letter-spacing: 0.03em;
  }

  .discord-avatar-wrapper {
    position: relative;
    width: fit-content;
  }

  .discord-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  .discord-avatar-dot {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    border: 2px solid #0f0f0f;
  }

  /* Info rows */
  .info-col {
    display: flex;
    flex-direction: column;
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0.9rem 0;
  }

  .info-key {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240,232,224,0.3);
  }

  .info-val {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .info-divider {
    height: 1px;
    background: rgba(255,255,255,0.05);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-pink);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-pink);
    animation: pulse-ring 2s infinite;
    flex-shrink: 0;
  }
</style>
