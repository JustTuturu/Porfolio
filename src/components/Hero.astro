---
import { META, ROLES } from "../data/index";
---

<section
    id="hero"
    class="relative w-full flex items-center justify-center overflow-hidden bg-cover bg-center"
    style={{
        backgroundImage: "url('/images/hero.webp')",
        backgroundAttachment: "fixed",
    }}
    aria-label="Hero section"
>
    <!-- Vignette overlay -->
    <div
        class="absolute inset-0 bg-linear-to-r from-[#00000080] via-transparent to-[#00000080] opacity-90"
        style="box-shadow: inset 80px 0 120px #050508, inset -80px 0 120px #050508"
        aria-hidden="true"
    >
    </div>

    <!-- Content container -->
    <div
        class="relative z-10 content-container text-center flex flex-col items-center justify-center gap-8"
    >
        <!-- Main content -->
        <div class="space-y-6">
            <!-- Large title -->
            <h1
                class="type-display-small sm:type-display-medium md:type-display-large text-white font-bold tracking-tight"
            >
                AI/ML
            </h1>

            <!-- Name -->
            <h2
                class="type-headline-medium sm:type-headline-large text-text-primary font-heading"
            >
                {META.name}
            </h2>

            <!-- Typewriter effect -->
            <div
                class="h-10 flex items-center justify-center"
                aria-live="polite"
                aria-atomic="true"
            >
                <p
                    class="type-title-large text-accent-pink font-medium font-mono"
                >
                    <span id="typewriter">AI/ML Engineer</span><span
                        class="cursor"
                        aria-hidden="true">_</span
                    >
                </p>
            </div>

            <!-- Description -->
            <p class="type-body-large text-text-muted max-w-xl mx-auto px-2">
                Crafting intelligent systems with deep learning, LLMs, and
                modern AI. Currently actively seeking internships {
                    new Date().getFullYear()
                }.
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4">
                <a
                    href="#projects"
                    class="type-label-large px-6 py-3 bg-accent-pink text-white rounded-lg hover:bg-accent-coral transition-colors text-center no-underline"
                    aria-label="View my work"
                >
                    View my work
                </a>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    var roles = [
        "AI/ML Engineer",
        "LLM Fine-Tuning Enthusiast",
        "Deep Learning Explorer",
        "Tuturu~",
    ];
    var el = document.getElementById("typewriter");

    if (el) {
        var i = 0;
        var j = 0;
        var deleting = false;

        function type() {
            if (!el) return;
            var word = roles[i];
            el.textContent = deleting ? word.slice(0, --j) : word.slice(0, ++j);

            if (!deleting && j === word.length) {
                deleting = true;
                setTimeout(type, 1500);
                return;
            }

            if (deleting && j === 0) {
                deleting = false;
                i = (i + 1) % roles.length;
            }

            setTimeout(type, deleting ? 60 : 100);
        }

        type();
    }
</script>
