---
import { META } from "../data/index";
---

<section id="about" class="section-padding" aria-labelledby="about-heading">
    <div class="content-container">
        <span class="section-label animate-on-scroll" id="about-heading"
            >// about</span
        >
        <h2 class="section-heading animate-on-scroll">About Me</h2>

        <div class="about-grid animate-on-scroll delay-1">
            <div class="flex flex-col gap-5">
                <p class="type-body-medium text-(--text-primary)/55">
                    I'm a CS student who loves building AI systems — from
                    fine-tuning LLMs to RAG pipelines and computer vision
                    projects.
                </p>
                <p class="type-body-medium text-(--text-primary)/55">
                    Still learning, always building. Currently looking for
                    internships where I can contribute and grow.
                </p>

                <!-- Buttons -->
                <div
                    class="flex items-center gap-6 flex-wrap mt-2"
                    aria-label="Quick links"
                >
                    <a
                        href="/resume.pdf"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-w-18 items-center gap-1 px-4 py-2 whitespace-nowrap bg-black text-white rounded-full type-label-large no-underline transition-opacity duration-300 hover:opacity-85"
                        aria-label="View resume (opens in new tab)"
                    >
                        <svg
                            class="shrink-0"
                            width="12"
                            height="12"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                            ><line x1="7" y1="17" x2="17" y2="7"
                            ></line><polyline points="7 7 17 7 17 17"
                            ></polyline></svg
                        >
                        Resume
                    </a>
                    <a
                        href={`mailto:${META.email}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-2 py-2 bg-transparent text-(--text-primary) border border-white/12 rounded-full type-label-large no-underline transition-[border-color,opacity] duration-300 opacity-70 hover:border-white/30 hover:opacity-100"
                        aria-label="Send email (opens in new tab)"
                    >
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
                            ></path>
                        </svg>
                    </a>
                    <a
                        href={META.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-2 py-2 bg-transparent text-(--text-primary) border border-white/12 rounded-full type-label-large no-underline transition-[border-color,opacity] duration-300 opacity-70 hover:border-white/30 hover:opacity-100"
                        aria-label="Visit LinkedIn profile (opens in new tab)"
                    >
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                            ><path
                                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href={META.twitter}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-2 py-2 bg-transparent text-(--text-primary) border border-white/12 rounded-full type-label-large no-underline transition-[border-color,opacity] duration-300 opacity-70 hover:border-white/30 hover:opacity-100"
                        aria-label="Visit X profile (opens in new tab)"
                    >
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.736-8.835L1.254 2.25H8.08l4.259 5.63 5.905-5.63Zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                            ></path>
                        </svg>
                    </a>
                    <a
                        href={META.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-2 py-2 bg-transparent text-(--text-primary) border border-white/12 rounded-full type-label-large no-underline transition-[border-color,opacity] duration-300 opacity-70 hover:border-white/30 hover:opacity-100"
                        aria-label="Visit GitHub profile (opens in new tab)"
                    >
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                            ><path
                                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
                            ></path></svg
                        >
                    </a>
                </div>
            </div>

            <div class="flex flex-col">
                <div
                    class="pt-0 pb-0 pl-0 flex flex-col gap-3"
                    aria-label="Discord status"
                >
                    <div
                        class="about-discord-header flex items-center justify-between gap-3"
                    >
                        <span
                            class="font-['JetBrains_Mono'] type-label-small uppercase text-(--text-primary)/30"
                            >// Discord</span
                        >
                        <span
                            id="discord-status-badge"
                            class="inline-flex items-center gap-1.5 rounded-full border border-white/8 bg-white/3 px-2.5 py-1 type-label-small uppercase text-(--text-primary)/42 transition-[background,border-color,color] duration-300"
                        >
                            <span
                                class="discord-dot w-1.5 h-1.5 rounded-full bg-white/20 shrink-0 transition-[background] duration-300"
                                aria-hidden="true"></span>
                            <span id="discord-status-text">Offline</span>
                        </span>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="relative w-fit shrink-0">
                            <span
                                class="discord-avatar-dot absolute bottom-0 right-0 w-3 h-3 rounded-full bg-white/20 border-2 border-[#0f0f0f]"
                                aria-hidden="true"></span>
                            <img
                                class="discord-avatar w-12 h-12 rounded-full object-cover bg-white/5 ring-1 ring-white/8"
                                src=""
                                alt={`Discord avatar for ${META.discord}`}
                                width="48"
                                height="48"
                                loading="lazy"
                            />
                        </div>

                        <div class="min-w-0 flex flex-col gap-1">
                            <p
                                class="type-body-medium font-medium text-(--text-primary)"
                            >
                                suzu
                            </p>
                            <p
                                class="type-body-small text-(--text-primary)/30"
                                id="discord-activity"
                                aria-live="polite"
                            >
                                no current activity
                            </p>
                        </div>
                    </div>
                </div>

                <div
                    class="h-px bg-white/5"
                    role="separator"
                    aria-hidden="true"
                >
                </div>

                <div class="flex flex-col gap-1 py-4">
                    <span
                        class="type-label-small uppercase text-(--text-primary)/30"
                        >Location</span
                    >
                    <span
                        class="type-body-medium font-medium text-(--text-primary)"
                        >{META.location}</span
                    >
                </div>

                <div
                    class="h-px bg-white/5"
                    role="separator"
                    aria-hidden="true"
                >
                </div>

                <div class="flex flex-col gap-1 py-4">
                    <span
                        class="type-label-small uppercase text-(--text-primary)/30"
                        >Status</span
                    >
                    <span
                        class="type-body-medium font-medium text-(--accent-pink) flex items-center gap-2"
                    >
                        <span
                            class="w-1.5 h-1.5 rounded-full bg-(--accent-pink) animate-[pulse-ring_2s_infinite] shrink-0"
                            aria-hidden="true"></span>
                        {
                            META.available
                                ? "Available for internships"
                                : "Not available"
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline define:vars={{ discordId: META.discord }}>
    var DISCORD_USER_ID = discordId;

    function fetchDiscordStatus() {
        fetch("https://api.lanyard.rest/v1/users/" + DISCORD_USER_ID)
            .then(function (res) {
                return res.json();
            })
            .then(function (data) {
                if (!data.success) return;

                var discord_status = data.data.discord_status;
                var activities = data.data.activities;
                var discord_user = data.data.discord_user;

                var dot = document.querySelector(".discord-dot");
                var avatarDot = document.querySelector(".discord-avatar-dot");
                var statusBadge = document.getElementById(
                    "discord-status-badge",
                );
                var statusText = document.getElementById("discord-status-text");
                var activityEl = document.getElementById("discord-activity");
                var avatarEl = document.querySelector(".discord-avatar");

                var colors = {
                    online: "#57F287",
                    idle: "#FEE75C",
                    dnd: "#ED4245",
                    offline: "rgba(255,255,255,0.2)",
                };

                var color = colors[discord_status] || colors.offline;
                if (dot) dot.style.background = color;
                if (avatarDot) avatarDot.style.background = color;
                if (statusText)
                    statusText.textContent =
                        discord_status === "dnd"
                            ? "do not disturb"
                            : discord_status;
                if (statusBadge) {
                    statusBadge.classList.remove(
                        "discord-status-online",
                        "discord-status-idle",
                        "discord-status-dnd",
                    );
                    if (discord_status === "online")
                        statusBadge.classList.add("discord-status-online");
                    if (discord_status === "idle")
                        statusBadge.classList.add("discord-status-idle");
                    if (discord_status === "dnd")
                        statusBadge.classList.add("discord-status-dnd");
                }

                var activity = null;
                if (activities) {
                    for (var i = 0; i < activities.length; i++) {
                        if (activities[i].type === 0) {
                            activity = activities[i];
                            break;
                        }
                    }
                }

                if (activityEl) {
                    activityEl.textContent = activity
                        ? "playing " + activity.name
                        : activities && activities[0] && activities[0].state
                          ? activities[0].state
                          : "no current activity";
                }

                if (avatarEl && discord_user) {
                    var avatarHash = discord_user.avatar;
                    if (avatarHash) {
                        var ext =
                            avatarHash.indexOf("a_") === 0 ? "gif" : "webp";
                        avatarEl.src =
                            "https://cdn.discordapp.com/avatars/" +
                            DISCORD_USER_ID +
                            "/" +
                            avatarHash +
                            "." +
                            ext +
                            "?size=64";
                    } else {
                        var defaultIndex =
                            Number(BigInt(DISCORD_USER_ID) >> BigInt(22)) % 6;
                        avatarEl.src =
                            "https://cdn.discordapp.com/embed/avatars/" +
                            defaultIndex +
                            ".png";
                    }
                }
            })
            .catch(function () {
                // Fail silently — the 30s interval retries automatically.
                // Never log to console here: Lighthouse fails errors-in-console
                // on any developer console.error().
            });
    }

    function scheduleStatusFetch() {
        var run = function () {
            fetchDiscordStatus();
        };
        // Fire after the whole page has loaded, then on idle, so the first
        // Lanyard request never contends with LCP / the render path. The
        // Discord status simply appears a beat later.
        if (document.readyState === "complete") {
            idleRun(run);
        } else {
            window.addEventListener("load", function () {
                idleRun(run);
            }, { once: true });
        }
    }

    function idleRun(fn) {
        if ("requestIdleCallback" in window) {
            requestIdleCallback(fn, { timeout: 6000 });
        } else {
            setTimeout(fn, 6000);
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        scheduleStatusFetch();
        setInterval(fetchDiscordStatus, 30000);
    });
</script>

<style>
    .about-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 4rem;
        align-items: start;
    }

    @media (max-width: 900px) {
        .about-grid {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }
    }

    @media (max-width: 640px) {
        .about-discord-header {
            flex-direction: column;
            align-items: flex-start;
        }

        #discord-status-badge {
            align-self: flex-start;
        }
    }

    @keyframes pulse-ring {
        0% {
            box-shadow: 0 0 0 0 rgba(232, 160, 168, 0.5);
        }
        70% {
            box-shadow: 0 0 0 8px rgba(232, 160, 168, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(232, 160, 168, 0);
        }
    }

    .discord-status-online {
        color: #57f287;
        border-color: rgba(87, 242, 135, 0.22);
        background: rgba(87, 242, 135, 0.08);
    }

    .discord-status-idle {
        color: #fee75c;
        border-color: rgba(254, 231, 92, 0.2);
        background: rgba(254, 231, 92, 0.07);
    }

    .discord-status-dnd {
        color: #ed4245;
        border-color: rgba(237, 66, 69, 0.2);
        background: rgba(237, 66, 69, 0.07);
    }
</style>
