---
import { GITHUB_STATS, REPOS, HEATMAP_DATA } from '../data/index';

// Generate heatmap data with colors
const heatmapColors = ['#16213e', '#FF999940', '#FF999970', '#FF9999aa', '#FF9999'];
---

<section id="github" class="relative bg-bg-base py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-4xl md:text-5xl font-bold text-text-primary mb-12 font-heading animate-on-scroll">
      GitHub Activity
    </h2>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 animate-on-scroll delay-1">
      <div class="glass p-6 text-center">
        <p class="text-3xl font-bold text-accent-pink">{GITHUB_STATS.commits}</p>
        <p class="text-xs text-text-muted mt-2 uppercase tracking-wider">Commits</p>
      </div>

      <div class="glass p-6 text-center">
        <p class="text-3xl font-bold text-accent-blue">{GITHUB_STATS.prs}</p>
        <p class="text-xs text-text-muted mt-2 uppercase tracking-wider">Pull Requests</p>
      </div>

      <div class="glass p-6 text-center">
        <p class="text-xl font-bold text-accent-purple">{GITHUB_STATS.topLanguage}</p>
        <p class="text-xs text-text-muted mt-2 uppercase tracking-wider">Top Language</p>
      </div>

      <div class="glass p-6 text-center">
        <p class="text-2xl font-bold text-accent-orange">{GITHUB_STATS.streak}</p>
        <p class="text-xs text-text-muted mt-2 uppercase tracking-wider">Streak</p>
      </div>
    </div>

    <!-- Contribution heatmap -->
    <div class="mb-12 animate-on-scroll delay-2">
      <h3 class="text-lg font-mono text-accent-blue mb-4">Contribution Activity</h3>
      <div class="glass p-6">
        <div class="grid" style="grid-template-columns: repeat(7, 1fr); gap: 4px;">
          {HEATMAP_DATA.map((day) => (
            <div
              class="w-3 h-3 rounded-sm transition-all duration-200 hover:w-4 hover:h-4 cursor-pointer"
              style={`background-color: ${heatmapColors[day.intensity]}`}
              title={`${day.count} contributions`}
            ></div>
          ))}
        </div>
        <p class="text-xs text-text-muted mt-4">52 weeks of contributions</p>
      </div>
    </div>

    <!-- Top repos -->
    {REPOS.length > 0 && (
      <div class="animate-on-scroll delay-3">
        <h3 class="text-lg font-mono text-accent-blue mb-4">Featured Repos</h3>
        <div class="grid md:grid-cols-2 gap-4">
          {REPOS.map((repo) => (
            <a href={repo.url} target="_blank" class="glass p-6 hover:border-accent-pink transition-all duration-300 group">
              <div class="flex items-start justify-between mb-3">
                <h4 class="text-lg font-bold text-text-primary group-hover:text-accent-pink transition-colors">{repo.name}</h4>
                <span class="text-xs font-mono text-accent-orange">{repo.lang}</span>
              </div>

              <p class="text-sm text-text-muted mb-4">{repo.desc}</p>

              <div class="flex items-center gap-4 text-xs text-text-muted">
                <span class="flex items-center gap-1">
                  <span>⭐</span>
                  <span>{repo.stars}</span>
                </span>
                <span class="flex items-center gap-1">
                  <span>🔀</span>
                  <span>{repo.forks}</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  section {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  :global(:root) {
    --accent-purple: #B895C0;
  }
</style>
