---
import { META } from '../data/index';
---

<section id="contact" class="relative bg-bg-base min-h-screen flex flex-col justify-center px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl mx-auto">
    <!-- Contact info -->
    <div class="mt-12 pt-8 border-t border-glass-border animate-on-scroll delay-3">
      <p class="text-text-muted text-sm mb-4">Or reach out directly:</p>
      <div class="flex flex-col gap-3">
        <a href={`mailto:${META.email}`} class="text-accent-black hover:text-accent-pink transition-colors font-mono text-sm">
          Email: {META.email}
        </a>
        <a href={META.github} target="_blank" class="text-accent-black hover:text-accent-pink transition-colors font-mono text-sm">
          GitHub: {META.github}
        </a>
        <a href={META.linkedin} target="_blank" class="text-accent-black hover:text-accent-pink transition-colors font-mono text-sm">
          LinkedIn: {META.linkedin}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  input.glass,
  textarea.glass {
    background: var(--bg-glass);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
  }

  input.glass:focus,
  textarea.glass:focus {
    border-color: var(--accent-black);
    box-shadow: 0 0 20px rgba(238, 234, 234, 0.932);
  }
</style>
