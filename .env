# Environment Variables for Anime Lo-Fi Portfolio
# Copy this file to .env and fill in the values as needed

# Site Configuration
SITE_TITLE=AI/ML Engineer Portfolio
SITE_DESCRIPTION=Modern portfolio for AI/ML engineer

# API Keys (if integrating with external services in the future)
# EXAMPLE_API_KEY=your_api_key_here

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_COMMENTS=false

# Development
NODE_ENV=development