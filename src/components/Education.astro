---
import { EDUCATION, CERTIFICATIONS } from '../data/index';
---

<section id="education" style="padding: 5rem 1.5rem;">
  <div class="content-container">

    <span class="section-label animate-on-scroll">// education</span>
    <h2 class="section-heading animate-on-scroll">Education & Certifications</h2>

    <div class="edu-grid animate-on-scroll delay-1">

      <!-- Left: Degree -->
      <div>
        <p class="col-label">Degree</p>

        <div class="edu-card">
          <h3 class="uni-name">{EDUCATION.university}</h3>
          <p class="degree">{EDUCATION.degree} — {EDUCATION.major}</p>

          <div class="meta-row">
            <span class="meta-item">
              <span class="meta-key">Graduation</span>
              <span class="meta-val">{EDUCATION.graduation}</span>
            </span>
            <span class="meta-item">
              <span class="meta-key">GPA</span>
              <span class="meta-val">{EDUCATION.cgpa}</span>
            </span>
          </div>

          <div class="courses">
            {EDUCATION.courses.map((course) => (
              <span class="course-tag">{course}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Certifications -->
      <div>
        <p class="col-label">Certifications</p>

        <div class="cert-list">
          {CERTIFICATIONS.map((cert) => (
            <div class="cert-row">
              <div>
                <p class="cert-name">{cert.name}</p>
                <p class="cert-meta">{cert.platform} · {cert.date}</p>
              </div>
              {cert.featured && <span class="featured-badge">Featured</span>}
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .edu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .col-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-pink);
    margin-bottom: 1rem;
  }

  .edu-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .uni-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .degree {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: rgba(241,245,249,0.5);
  }

  .meta-row {
    display: flex;
    gap: 2rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-key {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(241,245,249,0.3);
  }

  .meta-val {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .courses {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .course-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: rgba(241,245,249,0.45);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 4px;
    padding: 2px 8px;
  }

  /* Certifications */
  .cert-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .cert-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .cert-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cert-name {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .cert-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: rgba(241,245,249,0.35);
    letter-spacing: 0.05em;
  }

  .featured-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-pink);
    border: 1px solid var(--accent-pink);
    border-radius: 4px;
    padding: 2px 6px;
    white-space: nowrap;
    opacity: 0.7;
  }
</style>