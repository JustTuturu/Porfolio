---
import { PROJECTS } from '../data/index';

const featured = PROJECTS.find((p) => p.featured);
const others = PROJECTS.filter((p) => !p.featured);
---

<section id="projects" class="section-padding">
  <div class="content-container">
    <!-- Section label -->
    <span class="section-label animate-on-scroll">// PROJECTS</span>
    
    <!-- Section heading -->
    <h2 class="section-heading animate-on-scroll">
      Featured Projects
    </h2>

    <!-- Featured project (large) -->
    {
      featured && (
        <div class="mb-12 animate-on-scroll delay-1">
          <div class="card group cursor-pointer">
            <!-- Top row: category + label -->
            <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
              <span class="badge" style={`background-color: ${featured.categoryColor}20; color: ${featured.categoryColor}; border-color: ${featured.categoryColor}40;`}>
                {featured.category}
              </span>
              <span class="mono-label">{featured.label}</span>
            </div>

            <!-- Title + Description -->
            <h3 class="card-title text-2xl mb-4 group-hover:text-accent-pink transition-colors">{featured.title}</h3>
            <p class="body-text mb-6">{featured.description}</p>

            <!-- Metrics -->
            <div class="flex flex-wrap gap-3 mb-6">
              {featured.metrics.map((metric) => (
                <span class="mono-label bg-bg-glass px-3 py-1 rounded-lg">{metric}</span>
              ))}
            </div>

            <!-- Tech stack -->
            <div class="flex flex-wrap gap-2 mb-6">
              {featured.tech.map((t) => (
                <span class="badge">{t}</span>
              ))}
            </div>

            <!-- Links -->
            <div class="flex gap-4">
              {featured.github && (
                <a href={featured.github} target="_blank" class="mono-label hover:text-accent-pink transition-colors">
                  View Code →
                </a>
              )}
              {featured.demo && (
                <a href={featured.demo} target="_blank" class="mono-label hover:text-accent-blue transition-colors">
                  Live Demo →
                </a>
              )}
            </div>
          </div>
        </div>
      )
    }

    <!-- Other projects (grid) -->
    {
      others.length > 0 && (
        <>
          <h3 class="section-label animate-on-scroll delay-2">OTHER PROJECTS</h3>
          <div class="grid md:grid-cols-2 gap-6">
            {others.map((project, idx) => (
              <div class={`card group cursor-pointer animate-on-scroll delay-${Math.min((idx % 4) + 1, 4)}`}>
                <!-- Category badge -->
                <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                  <span class="badge" style={`background-color: ${project.categoryColor}20; color: ${project.categoryColor}; border-color: ${project.categoryColor}40;`}>
                    {project.category}
                  </span>
                  <span class="mono-label">{project.label}</span>
                </div>

                <!-- Title + Desc -->
                <h4 class="card-title mb-2 group-hover:text-accent-pink transition-colors">{project.title}</h4>
                <p class="body-text text-sm mb-4">{project.description}</p>

                <!-- Metrics -->
                {project.metrics.length > 0 && (
                  <div class="mono-label text-xs mb-3">{project.metrics.join(' • ')}</div>
                )}

                <!-- Tech -->
                <div class="flex flex-wrap gap-1 mb-4">
                  {project.tech.map((t) => (
                    <span class="badge text-xs">{t}</span>
                  ))}
                </div>

                <!-- Link -->
                {project.github && (
                  <a href={project.github} target="_blank" class="mono-label hover:text-accent-pink transition-colors text-xs">
                    View Code →
                  </a>
                )}
              </div>
            ))}
          </div>
        </>
      )
    }
  </div>
</section>
