---

<div
  id="scroll-indicator"
  class="fixed right-6 top-1/2 transform -translate-y-1/2 z-40 flex flex-col gap-4"
>
  <button
    data-target="hero"
    class="scroll-dot w-2 h-2 md:w-3 md:h-3 rounded-full bg-text-muted hover:bg-accent-pink transition-all duration-300 active"
    title="Hero"
  ></button>

  <button
    data-target="about"
    class="scroll-dot w-2 h-2 md:w-3 md:h-3 rounded-full bg-text-muted hover:bg-accent-violet transition-all duration-300"
    title="About"
  ></button>

  <button
    data-target="projects"
    class="scroll-dot w-2 h-2 md:w-3 md:h-3 rounded-full bg-text-muted hover:bg-accent-violet transition-all duration-300"
    title="Projects"
  ></button>

  <button
    data-target="education"
    class="scroll-dot w-2 h-2 md:w-3 md:h-3 rounded-full bg-text-muted hover:bg-accent-violet transition-all duration-300"
    title="Education"
  ></button>

  <button
    data-target="contact"
    class="scroll-dot w-2 h-2 md:w-3 md:h-3 rounded-full bg-text-muted hover:bg-accent-violet transition-all duration-300"
    title="Contact"
  ></button>
</div>

<script>
  const sections = document.querySelectorAll('section[id]');
  const dots = document.querySelectorAll('.scroll-dot');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const currentActive = document.querySelector('.dot.active');
          if (currentActive) {
            currentActive.classList.remove('active');
          }

          const targetDot = document.querySelector(`[data-target="${entry.target.id}"]`);
          if (targetDot) {
            targetDot.classList.add('active');
          }
        }
      });
    },
    { threshold: 0.6 }
  );

  sections.forEach((section) => observer.observe(section));

  // Click to scroll
  dots.forEach((dot) => {
    dot.addEventListener('click', (e) => {
      e.preventDefault();
      const target = (dot as HTMLElement).getAttribute('data-target');
      const section = document.getElementById(target || '');
      section?.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>

<style>
  .scroll-dot.active {
    background: var(--accent-pink);
    box-shadow: 0 0 8px var(--accent-pink);
  }
</style>
