---
<div
  id="scroll-indicator"
  class="fixed right-6 top-1/2 -translate-y-1/2 z-40 flex flex-col gap-4"
>
  <button data-target="hero"      class="scroll-dot" title="Hero"></button>
  <button data-target="about"     class="scroll-dot" title="About"></button>
  <button data-target="projects"  class="scroll-dot" title="Projects"></button>
  <button data-target="education" class="scroll-dot" title="Education"></button>
  <button data-target="contact"   class="scroll-dot" title="Contact"></button>
</div>

<script>
  const sections = document.querySelectorAll('section[id]');
  const dots = document.querySelectorAll('.scroll-dot');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const currentActive = document.querySelector('.scroll-dot.active');
          if (currentActive) currentActive.classList.remove('active');

          const targetDot = document.querySelector(`[data-target="${entry.target.id}"]`);
          if (targetDot) targetDot.classList.add('active');
        }
      });
    },
    { rootMargin: '-40% 0px -40% 0px' }
  );

  sections.forEach((section) => observer.observe(section));

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const target = (dot as HTMLElement).getAttribute('data-target');
      const section = document.getElementById(target || '');
      section?.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>

<style>
  .scroll-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(241, 245, 249, 0.3);  
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .scroll-dot:hover {
    background: var(--accent-pink);
    transform: scale(1.3);
  }

  .scroll-dot.active {
    background: var(--accent-pink);
    box-shadow: 0 0 8px var(--accent-pink);
    transform: scale(1.2);
  }
</style>