---
import { EDUCATION, CERTIFICATIONS } from '../data/index';
---

<section id="education" class="section-padding">
  <div class="content-container">
    <!-- Section label -->
    <span class="section-label animate-on-scroll">// EDUCATION</span>
    
    <!-- Section heading -->
    <h2 class="section-heading animate-on-scroll">
      Education & Certifications
    </h2>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Education -->
      <div class="animate-on-scroll delay-1">
        <h3 class="mono-label mb-6">DEGREE</h3>

        <div class="card">
          <h4 class="card-title text-xl mb-2">{EDUCATION.university}</h4>
          <p class="body-text font-semibold mb-4" style="color: var(--accent-violet);">
            {EDUCATION.degree} in {EDUCATION.major}
          </p>

          <div class="space-y-2 mb-6">
            <p class="body-text text-sm">
              <span class="mono-label">Graduation:</span> {EDUCATION.graduation}
            </p>
            <p class="body-text text-sm">
              <span class="mono-label" style="color: var(--accent-amber);">GPA:</span> {EDUCATION.cgpa}
            </p>
          </div>

          <div>
            <h5 class="card-title text-sm mb-3">Key Courses</h5>
            <div class="flex flex-wrap gap-2">
              {EDUCATION.courses.map((course) => (
                <span class="badge">{course}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Certifications -->
      <div class="animate-on-scroll delay-2">
        <h3 class="mono-label mb-6">CERTIFICATIONS</h3>

        <div class="space-y-4">
          {CERTIFICATIONS.map((cert) => (
            <div class={`card ${cert.featured ? 'border-accent-violet' : ''}`}>
              <div class="flex items-start justify-between gap-3 mb-2">
                <div>
                  <h4 class="card-title">{cert.name}</h4>
                  <p class="body-text text-xs">{cert.platform}</p>
                </div>
                {cert.featured && <span class="badge" style="background: var(--accent-violet)20; color: var(--accent-violet);">Featured</span>}
              </div>
              <p class="body-text text-xs">{cert.date}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
