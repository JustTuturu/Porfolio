---
import { META } from '../data/index';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-glass-border py-12 px-4 sm:px-6 lg:px-8">
  <div class="content-container">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <!-- Branding -->
      <div class="animate-on-scroll">
        <h3 class="card-title mb-2">{META.name}</h3>
        <p class="body-text text-sm">{META.role}</p>
        <p class="body-text text-xs mt-2">{META.location}</p>
      </div>

      <!-- Links -->
      <div class="animate-on-scroll delay-1">
        <h4 class="mono-label mb-4">Navigation</h4>
        <div class="space-y-2">
          <a href="#about" class="block body-text text-sm hover:text-accent-cyan transition-colors">
            About
          </a>
          <a href="#projects" class="block body-text text-sm hover:text-accent-cyan transition-colors">
            Projects
          </a>
          <a href="#contact" class="block body-text text-sm hover:text-accent-cyan transition-colors">
            Contact
          </a>
        </div>
      </div>

      <!-- Social -->
      <div class="animate-on-scroll delay-2">
        <h4 class="mono-label mb-4">Connect</h4>
        <div class="space-y-2">
          <a href={META.github} target="_blank" class="block body-text text-sm hover:text-accent-cyan transition-colors">
            GitHub
          </a>
          <a href={META.linkedin} target="_blank" class="block body-text text-sm hover:text-accent-cyan transition-colors">
            LinkedIn
          </a>
          <a href={`mailto:${META.email}`} class="block body-text text-sm hover:text-accent-cyan transition-colors">
            Email
          </a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-glass-border my-8"></div>

    <!-- Bottom -->
    <div class="flex flex-col md:flex-row items-center justify-between text-xs body-text">
      <p>
        &copy; {currentYear} {META.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
