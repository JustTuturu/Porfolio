---
import { META } from "../data/index";
---

<section
    id="about"
    class="section-padding about-section"
    aria-labelledby="about-name"
>
    <div class="content-container">
        <span class="section-label">
            // about
        </span>
        <div class="about-intro animate-on-scroll delay-1">
            <div class="flex flex-col gap-5">
                <div class="flex flex-col gap-1">
                    <h1 id="about-name" class="type-headline-large font-['Fredoka'] font-semibold text-(--text-primary)">
                        {META.name}
                    </h1>
                    <p class="type-title-medium text-(--accent-pink)">
                        {META.role}
                    </p>
                </div>
                <p class="type-body-medium text-(--text-primary)/55">
                    I'm a grad CS student who loves building AI systems — from
                    fine-tuning LLMs to RAG pipelines and computer vision
                    projects.
                </p>
                <p class="type-body-medium text-(--text-primary)/55">
                    Always learning, continuously building. Currently looking
                    for internships where I can contribute and grow.
                </p>

                <!-- Buttons -->
                <div
                    class="flex items-center gap-4 flex-wrap mt-1"
                    aria-label="Quick links"
                >
                    <a
                        href="/resume.pdf"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-w-18 items-center gap-1 px-4 py-2 whitespace-nowrap bg-(--accent-pink) text-white rounded-full type-label-large no-underline transition-opacity duration-300 hover:opacity-85"
                        aria-label="View resume (opens in new tab)"
                    >
                        <svg
                            class="shrink-0"
                            width="12"
                            height="12"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <line x1="7" y1="17" x2="17" y2="7"></line>
                            <polyline points="7 7 17 7 17 17"></polyline>
                        </svg>
                        Resume
                    </a>
                    <a
                        href={`mailto:${META.email}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-2 py-2 bg-transparent text-(--text-primary) border border-(--glass-border) rounded-full type-label-large no-underline transition-[border-color,opacity] duration-300 opacity-70 hover:border-(--accent-blue) hover:opacity-100"
                        aria-label="Send email (opens in new tab)"
                    >
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"></path>
                        </svg>
                    </a>
                    <a
                        href={META.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-2 py-2 bg-transparent text-(--text-primary) border border-(--glass-border) rounded-full type-label-large no-underline transition-[border-color,opacity] duration-300 opacity-70 hover:border-(--accent-blue) hover:opacity-100"
                        aria-label="Visit LinkedIn profile (opens in new tab)"
                    >
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                        </svg>
                    </a>
                    <a
                        href={META.twitter}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-2 py-2 bg-transparent text-(--text-primary) border border-(--glass-border) rounded-full type-label-large no-underline transition-[border-color,opacity] duration-300 opacity-70 hover:border-(--accent-blue) hover:opacity-100"
                        aria-label="Visit X profile (opens in new tab)"
                    >
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.736-8.835L1.254 2.25H8.08l4.259 5.63 5.905-5.63Zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                        </svg>
                    </a>
                    <a
                        href={META.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1 px-2 py-2 bg-transparent text-(--text-primary) border border-(--glass-border) rounded-full type-label-large no-underline transition-[border-color,opacity] duration-300 opacity-70 hover:border-(--accent-blue) hover:opacity-100"
                        aria-label="Visit GitHub profile (opens in new tab)"
                    >
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"></path>
                        </svg>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    .about-section {
        padding-top: 2.5rem;
    }

    .about-intro {
        max-width: 42rem;
    }
</style>
