---
import { PROJECTS } from '../data/index';

const featured = PROJECTS.find((p) => p.featured);
const others = PROJECTS.filter((p) => !p.featured);
---

<section id="projects" style="padding: 5rem 1.5rem;" aria-labelledby="projects-heading">
  <div class="content-container">

    <span class="section-label animate-on-scroll" id="projects-heading">// projects</span>
    <h2 class="section-heading animate-on-scroll">Featured Projects</h2>

    <!-- Featured project -->
    {featured && (
      <article class="animate-on-scroll delay-1 mb-14 overflow- rounded-[1.4rem] border border-white/8 bg-white/[0.015] p-6 transition-[border-color,transform,background-color] duration-300 hover:-translate-y-[2px] hover:border-[var(--accent-pink)]/28 hover:bg-white/[0.02] sm:p-8" aria-label="Featured project: {featured.title}">

        <div class="mb-6 flex items-center justify-between gap-4">
          <span class="font-['JetBrains_Mono'] text-[0.64rem] tracking-[0.18em] uppercase" style={`color: ${featured.categoryColor};`}>
            {featured.category}
          </span>
          <span class="font-['Inter'] text-[0.78rem] text-[var(--text-primary)]/28 ">
            {featured.label}
          </span>
        </div>

        <div class="max-w-3xl space-y-3.5">
          <h3 class="font-['Space_Grotesk'] text-[1.45rem] font-semibold leading-[1.18] text-[var(--text-primary)] transition-colors duration-300 hover:text-[var(--accent-pink)]">
            {featured.title}
          </h3>
          <p class="font-['Inter'] text-[0.95rem] leading-[1.8] text-[var(--text-primary)]/52">
            {featured.description}
          </p>
        </div>

        <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2">
          {featured.metrics.map((m) => (
            <span class="font-['Inter'] text-[0.82rem] font-medium text-[var(--accent-cyan)]/88">
              {m}
            </span>
          ))}
        </div>

        <div class="mt-5 flex flex-wrap gap-x-3 gap-y-2">
          {featured.tech.map((t) => (
            <span class="font-['Inter'] text-[0.82rem] text-[var(--text-primary)]/40">
              {t}
            </span>
          ))}
        </div>

        <div class="mt-7 flex flex-wrap gap-5">
          {featured.github && (
            <a href={featured.github} target="_blank" rel="noopener noreferrer" class="font-['JetBrains_Mono'] text-[0.72rem] tracking-[0.08em] text-[var(--text-primary)]/48 no-underline transition-colors duration-300 hover:text-[var(--accent-pink)]" aria-label="View source code for {featured.title} (opens in new tab)">
              View Code →
            </a>
          )}
          {featured.demo && (
            <a href={featured.demo} target="_blank" rel="noopener noreferrer" class="font-['JetBrains_Mono'] text-[0.72rem] tracking-[0.08em] text-[var(--text-primary)]/48 no-underline transition-colors duration-300 hover:text-[var(--accent-pink)]" aria-label="View live demo for {featured.title} (opens in new tab)">
              Live Demo →
            </a>
          )}
        </div>

      </article>
    )}

    <!-- Other projects -->
    {others.length > 0 && (
      <>
        <p class="section-label animate-on-scroll mb-7" id="other-projects-label">Other Projects</p>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2" role="list" aria-labelledby="other-projects-label">
          {others.map((project, idx) => (
            <article class={`other-card animate-on-scroll delay-1-${Math.min(idx + 1, 4)} flex flex-col rounded-[1.25rem] border border-white/8 bg-white/[0.012] p-6 transition-[border-color,transform,background-color] duration-300 hover:-translate-y-[2px] hover:border-[var(--accent-pink)]/26 hover:bg-white/[0.02] sm:p-7`} role="listitem" aria-label="Project: {project.title}">

              <div class="mb-5 flex items-center justify-between gap-4">
                <span class="font-['JetBrains_Mono'] text-[0.64rem] tracking-[0.18em] uppercase" style={`color: ${project.categoryColor};`}>
                  {project.category}
                </span>
                <span class="font-['Inter'] text-[0.76rem] text-[var(--text-primary)]/26">
                  {project.label}
                </span>
              </div>

              <div class="space-y-3.5">
                <h4 class="font-['Space_Grotesk'] text-[1.12rem] font-semibold leading-[1.25] text-[var(--text-primary)] transition-colors duration-300 hover:text-[var(--accent-pink)]">
                  {project.title}
                </h4>
                <p class="font-['Inter'] text-[0.92rem] leading-[1.75] text-[var(--text-primary)]/50">
                  {project.description}
                </p>
              </div>

              {project.metrics.length > 0 && (
                <p class="mt-5 font-['Inter'] text-[0.82rem] font-medium text-[var(--accent-cyan)]/82">
                  {project.metrics.join(' · ')}
                </p>
              )}

              <div class="mt-5 flex flex-wrap gap-x-3 gap-y-2">
                {project.tech.map((t) => (
                  <span class="font-['Inter'] text-[0.82rem] text-[var(--text-primary)]/40">
                    {t}
                  </span>
                ))}
              </div>

              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="mt-6 font-['JetBrains_Mono'] text-[0.72rem] tracking-[0.08em] text-[var(--text-primary)]/48 no-underline transition-colors duration-300 hover:text-[var(--accent-pink)]" aria-label="View source code for {project.title} (opens in new tab)">
                  View Code →
                </a>
              )}

            </article>
          ))}
        </div>
      </>
    )}

  </div>
</section>
