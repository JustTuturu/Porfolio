---
import { META } from '../data/index';
const currentYear = new Date().getFullYear();
---

<footer style="border-top: 1px solid var(--glass-border); padding-top: 1.5rem; padding-bottom: 1.5rem;">
  <div class="content-container">
    <div class="flex flex-col items-center gap-2 text-center">
      
      <!-- Left: Name -->
      <p class="font-['Raleway'] text-[0.9rem] tracking-[0.2em] uppercase text-(--text-muted)">
        {META.name}
      </p>

      <!-- Center: Tagline -->
      <p class="font-['Raleway'] text-[0.8rem] text-(--text-muted) tracking-wider">
        built with curiosity & too much coffee ☕
      </p>

      <!-- Right: Copyright -->
      <p class="font-['Raleway'] text-[0.8rem] text-(--text-muted) tracking-wider">
        &copy; {currentYear}
      </p>

    </div>
  </div>
</footer>
