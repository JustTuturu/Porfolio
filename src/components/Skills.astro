---
import { SKILLS } from '../data/index.ts';
const { isFirstPage = false } = Astro.props;
---

<style>
  :root {
    --bg-base: #0b0b0c;
    --text-muted: #ffffff;
    --text-primary: #ffffff;
  }

  .skills-section {
    position: relative;
    overflow: hidden;
    padding: 1.5rem 0;
    background: ${isFirstPage ? 'transparent' : 'var(--bg-base)'};
  }

  .skills-label {
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8em;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    opacity: 0.65;
  }

  /* Fade left/right edges */
  .fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }
  .fade-left  { left: 0;  background: linear-gradient(to right, var(--bg-base), transparent); }
  .fade-right { right: 0; background: linear-gradient(to left,  var(--bg-base), transparent); }

  /* Scrolling row */
  .skills-track {
    display: flex;
    width: max-content;
    animation: scroll-left 30s linear infinite;
  }

  /* Pause on hover */
  .skills-track:hover {
    animation-play-state: paused;
  }

  .skills-group {
    display: flex;
    align-items: center;
    gap: 3rem;
    padding-right: 3rem; /* gap between the two groups */
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    opacity: 0.4;
    transition: opacity 0.3s ease;
    cursor: default;
    user-select: none;
  }

  .tech-item:hover {
    opacity: 1;
  }

  .tech-item img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    filter: grayscale(1) brightness(1.4);
  }

  .tech-item span {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: 0.1em;
  }

  /* The core animation: slides exactly 50% (one full copy) */
  @keyframes scroll-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .skills-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      padding: 0 2rem;
      gap: 1.5rem;
    }
    .skills-group:last-child { display: none; }
    .fade { display: none; }
  }
</style>

<div id="skills" class="skills-section">
  <p class="skills-label">Tech Stack</p>

  <!-- Fade edges -->
  <div class="fade fade-left"></div>
  <div class="fade fade-right"></div>

  <!-- Scrolling track: duplicated group for seamless loop -->
  <div class="skills-track">
    <div class="skills-group">
      {SKILLS.map(({ name, icon }) => (
        <div class="tech-item">
          <img src={icon} alt={name} />
          <span>{name}</span>
        </div>
      ))}
    </div>
    <!-- Duplicate for seamless loop -->
    <div class="skills-group" aria-hidden="true">
      {SKILLS.map(({ name, icon }) => (
        <div class="tech-item">
          <img src={icon} alt={name} />
          <span>{name}</span>
        </div>
      ))}
    </div>
  </div>
</div>
