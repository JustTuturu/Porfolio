{
  "extends": ["config:recommended"],
  "platformAutomerge": true,
  "automerge": false,
  "ignoreTests": false,
  "prCreation": "immediate",
  "branchPrefix": "renovate/",
  "rangeStrategy": "pin",
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Auto-merge development dependency pins after CI passes",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["pin"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge patch updates for development dependencies after CI passes",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Auto-merge minor updates for development dependencies after CI passes",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Never auto-merge production dependencies",
      "matchDepTypes": ["dependencies"],
      "automerge": false
    },
    {
      "description": "Never auto-merge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update", "needs-review"]
    }
  ]
}
