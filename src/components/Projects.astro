---
import { PROJECTS } from '../data/index';

const featured = PROJECTS.find((p) => p.featured);
const others = PROJECTS.filter((p) => !p.featured);
---

<section id="projects" style="padding: 5rem 1.5rem;" aria-labelledby="projects-heading">
  <div class="content-container">

    <span class="section-label animate-on-scroll" id="projects-heading">// projects</span>
    <h2 class="section-heading animate-on-scroll">Featured Projects</h2>

    <!-- Featured project -->
    {featured && (
      <article class="featured-card animate-on-scroll delay-1" aria-label="Featured project: {featured.title}">

        <div class="featured-top">
          <span class="proj-category" style={`color: ${featured.categoryColor};`}>
            {featured.category}
          </span>
          <span class="proj-label">{featured.label}</span>
        </div>

        <h3 class="featured-title">{featured.title}</h3>
        <p class="proj-desc">{featured.description}</p>

        <div class="metrics-row">
          {featured.metrics.map((m) => (
            <span class="metric">{m}</span>
          ))}
        </div>

        <div class="tags-row">
          {featured.tech.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>

        <div class="links-row">
          {featured.github && (
            <a href={featured.github} target="_blank" rel="noopener noreferrer" class="proj-link" aria-label="View source code for {featured.title} (opens in new tab)">
              View Code →
            </a>
          )}
          {featured.demo && (
            <a href={featured.demo} target="_blank" rel="noopener noreferrer" class="proj-link" aria-label="View live demo for {featured.title} (opens in new tab)">
              Live Demo →
            </a>
          )}
        </div>

      </article>
    )}

    <!-- Other projects -->
    {others.length > 0 && (
      <>
        <p class="section-label animate-on-scroll" style="margin-bottom: 1.5rem;" id="other-projects-label">Other Projects</p>

        <div class="others-grid" role="list" aria-labelledby="other-projects-label">
          {others.map((project, idx) => (
            <article class={`other-card animate-on-scroll delay-1-${Math.min(idx + 1, 4)}`} role="listitem" aria-label="Project: {project.title}">

              <div class="featured-top">
                <span class="proj-category" style={`color: ${project.categoryColor};`}>
                  {project.category}
                </span>
                <span class="proj-label">{project.label}</span>
              </div>

              <h4 class="other-title">{project.title}</h4>
              <p class="proj-desc" style="font-size: 0.85rem;">{project.description}</p>

              {project.metrics.length > 0 && (
                <p class="metric-inline">{project.metrics.join(' · ')}</p>
              )}

              <div class="tags-row">
                {project.tech.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>

              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="proj-link" style="font-size: 0.75rem;" aria-label="View source code for {project.title} (opens in new tab)">
                  View Code →
                </a>
              )}

            </article>
          ))}
        </div>
      </>
    )}

  </div>
</section>

<style>
  /* Featured card */
  .featured-card {
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 3rem;
    transition: border-color 0.3s ease;
  }

  .featured-card:hover {
    border-color: rgba(255,153,153,0.3);
  }

  .featured-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .proj-category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .proj-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: rgba(241,245,249,0.3);
    letter-spacing: 0.1em;
  }

  .featured-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    transition: color 0.3s ease;
  }

  .featured-card:hover .featured-title {
    color: var(--accent-pink);
  }

  .proj-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: rgba(241,245,249,0.5);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .metrics-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .metric {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--accent-cyan);
    background: rgba(34,211,238,0.08);
    border: 1px solid rgba(34,211,238,0.15);
    border-radius: 4px;
    padding: 2px 8px;
  }

  .metric-inline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent-cyan);
    margin-bottom: 0.75rem;
    opacity: 0.7;
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: rgba(241,245,249,0.4);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 4px;
    padding: 2px 8px;
  }

  .links-row {
    display: flex;
    gap: 1.5rem;
  }

  .proj-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: rgba(241,245,249,0.5);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .proj-link:hover { color: var(--accent-pink); }

  /* Other projects grid */
  .others-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .other-card {
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 0.3s ease;
  }

  .other-card:hover {
    border-color: rgba(255,153,153,0.3);
  }

  .other-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color 0.3s ease;
  }

  .other-card:hover .other-title { color: var(--accent-pink); }
</style>
