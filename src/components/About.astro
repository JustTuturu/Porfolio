---
import { META, EDUCATION } from '../data/index';
---

<section id="about" class="section-padding">
  <div class="content-container">
    <!-- Section label -->
    <span class="section-label animate-on-scroll">// ABOUT</span>
    
    <!-- Section heading -->
    <h2 class="section-heading animate-on-scroll">
      About Me
    </h2>

    <!-- Content grid -->
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Left: Bio -->
      <div class="space-y-6 animate-on-scroll delay-1">
        <p class="body-text">
          I'm a passionate AI/ML engineer and computer science student 
          deeply interested in building intelligent systems. With a strong 
          foundation in deep learning, NLP, and computer vision, 
          I'm driven to solve real-world problems using cutting-edge AI technologies.
        </p>
        <p class="body-text">
          Whether it's fine-tuning large language models, building RAG pipelines, 
          or optimizing neural networks, I love the challenge of pushing the 
          boundaries of what's possible with AI. I'm currently seeking internship 
          opportunities to apply and expand my skills.
        </p>
        <p class="body-text">
          Outside of coding, you'll find me exploring new ML research papers, 
          contributing to open-source projects, or working on side projects that 
          combine my interests in AI and software engineering.
        </p>
      </div>

      <!-- Right: Stats cards -->
      <div class="space-y-4">
        <!-- Education card -->
        <div class="card animate-on-scroll delay-2">
          <h3 class="mono-label mb-3">EDUCATION</h3>
          <p class="card-title">{EDUCATION.university}</p>
          <p class="body-text mt-2">{EDUCATION.degree} in {EDUCATION.major}</p>
          <p class="body-text">Graduation: {EDUCATION.graduation}</p>
          <p class="mono-label mt-3">GPA: {EDUCATION.cgpa}</p>
        </div>

        <!-- Location card -->
        <div class="card animate-on-scroll delay-3">
          <h3 class="mono-label mb-3">LOCATION</h3>
          <p class="card-title">{META.location}</p>
          <p class="body-text mt-2">{META.availableFrom}</p>
        </div>

        <!-- Status card -->
        <div class="card animate-on-scroll delay-4 glow-pink">
          <h3 class="mono-label mb-3" style="color: var(--accent-pink);">STATUS</h3>
          <p class="card-title">
            {META.available ? 'Available' : 'Not available'}
          </p>
          <p class="body-text mt-2">Open to internships and collaborations</p>
        </div>
      </div>
    </div>
  </div>
</section>
