---
import { EDUCATION, CERTIFICATIONS } from '../data/index';
---

<section id="education" class="relative bg-bg-base py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-4xl md:text-5xl font-bold text-text-primary mb-12 font-heading animate-on-scroll">
      Education & Certifications
    </h2>

    <div class="grid md:grid-cols-2 gap-8">
      <div class="animate-on-scroll delay-1">
        <h3 class="text-xl font-mono text-accent-cyan mb-6">DEGREE</h3>

        <div class="glass p-8">
          <h4 class="text-2xl font-bold text-text-primary mb-2">{EDUCATION.university}</h4>
          <p class="text-lg text-accent-violet font-semibold mb-4">
            {EDUCATION.degree} in {EDUCATION.major}
          </p>

          <div class="space-y-2 mb-6">
            <p class="text-sm text-text-muted">
              <span class="font-mono text-accent-cyan">Graduation:</span> {EDUCATION.graduation}
            </p>
            <p class="text-sm text-text-muted">
              <span class="font-mono text-accent-amber">GPA:</span> {EDUCATION.cgpa}
            </p>
          </div>

          <div>
            <h5 class="text-sm font-mono text-text-primary mb-3">Key Courses</h5>
            <div class="flex flex-wrap gap-2">
              {EDUCATION.courses.map((course) => (
                <span class="text-xs bg-bg-glass text-text-primary px-3 py-1 rounded-lg border border-glass-border">
                  {course}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="animate-on-scroll delay-2">
        <h3 class="text-xl font-mono text-accent-cyan mb-6">CERTIFICATIONS</h3>

        <div class="space-y-4">
          {CERTIFICATIONS.map((cert) => (
            <div class={`glass p-4 hover:border-accent-cyan transition-all duration-300 ${cert.featured ? 'border-accent-violet' : ''}`}>
              <div class="flex items-start justify-between gap-3 mb-2">
                <div>
                  <h4 class="font-semibold text-text-primary">{cert.name}</h4>
                  <p class="text-xs text-text-muted">{cert.platform}</p>
                </div>
                {cert.featured && <span class="text-xs bg-accent-violet bg-opacity-20 text-accent-violet px-2 py-1 rounded whitespace-nowrap">Featured</span>}
              </div>
              <p class="text-xs text-text-muted">{cert.date}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
</style>
