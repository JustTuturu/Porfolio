---
import { PLAYLIST } from "../data/playlist";
---

<div
    id="music-widget"
    class="fixed top-16 right-4 z-100 hidden opacity-0 pointer-events-none max-sm:top-16 max-sm:right-4"
    role="dialog"
    aria-label="Music player"
    aria-hidden="true"
>
    <div
        class="music-shell relative overflow-hidden rounded-[24px] border border-white/8 bg-[rgba(13,14,24,0.88)] shadow-[0_24px_64px_rgba(3,4,10,0.55),inset_0_1px_0_rgba(255,255,255,0.04)] backdrop-blur-[22px]"
        style="width: min(18.5rem, calc(100vw - 2rem));"
    >
        <div class="music-orb music-orb--pink" aria-hidden="true"></div>
        <div class="music-orb music-orb--cyan" aria-hidden="true"></div>

        <div
            class="relative flex flex-col gap-2 bg-[linear-gradient(180deg,rgba(255,255,255,0.035),rgba(255,255,255,0.01))]"
            style="padding: 1.25rem; gap: 0.625rem;"
        >
            <!-- Row 1: Art + Info + Controls -->
            <div class="flex min-w-0 items-center gap-3">
                <!-- Album art -->
                <div class="music-art-link shrink-0">
                    <div
                        class="music-art-shell relative h-12 w-12 overflow-hidden rounded-[0.7rem] border border-white/8 bg-white/3 shadow-[inset_0_1px_0_rgba(255,255,255,0.04)]"
                    >
                        <div class="music-art-fallback" aria-hidden="true">
                            <span
                                class="font-['JetBrains_Mono'] text-[0.5rem] tracking-[0.25em] uppercase text-(--text-primary)/35"
                            >
                                idle
                            </span>
                        </div>
                        <img
                            id="music-art"
                            src=""
                            alt="Album artwork"
                            class="music-art-image"
                            style="display: none;"
                            width="48"
                            height="48"
                            loading="lazy"
                        />
                    </div>
                </div>

                <!-- Info -->
                <div class="min-w-0 flex-1 flex flex-col gap-[0.125rem]">
                    <p
                        id="music-song"
                        class="font-['Space_Grotesk'] text-[0.9rem] font-semibold leading-[1.25] text-(--text-primary) whitespace-nowrap overflow-hidden text-ellipsis"
                        aria-live="polite"
                    >
                        Nyan~
                    </p>
                    <p
                        id="music-artist"
                        class="font-['Inter'] text-[0.75rem] text-(--text-primary)/50 whitespace-nowrap overflow-hidden text-ellipsis"
                        aria-live="polite"
                    >
                    </p>
                    <p
                        id="music-meta"
                        class="font-['JetBrains_Mono'] text-[0.58rem] leading-[1.2] tracking-[0.1em] uppercase text-(--text-primary)/28 mt-0.5"
                        aria-live="polite"
                    >
                        Arrow up to open
                    </p>
                </div>

                <!-- Controls -->
                <div class="flex items-center gap-1 shrink-0">
                    <button
                        id="music-prev"
                        class="music-control-btn"
                        aria-label="Previous track"
                        title="Previous"
                    >
                        ⏮
                    </button>
                    <button
                        id="music-play"
                        class="music-control-btn music-control-btn--primary"
                        aria-label="Play"
                        title="Play/Pause"
                    >
                        ▶
                    </button>
                    <button
                        id="music-next"
                        class="music-control-btn"
                        aria-label="Next track"
                        title="Next"
                    >
                        ⏭
                    </button>
                </div>
            </div>

            <!-- Row 2: Progress + Time -->
            <div class="flex items-center gap-2.5">
                <input
                    id="music-progress"
                    type="range"
                    min="0"
                    max="100"
                    value="0"
                    step="0.1"
                    aria-label="Seek"
                    class="music-progress flex-1"
                />
                <span
                    id="music-time"
                    class="font-['JetBrains_Mono'] text-[0.6rem] tracking-[0.06em] text-(--text-primary)/35 whitespace-nowrap tabular-nums"
                >
                    0:00 / 0:00
                </span>
            </div>
        </div>
    </div>
</div>

<audio id="music-audio" preload="metadata"></audio>

<script is:inline define:vars={{ playlist: PLAYLIST }}>
    (function () {
        var widget = document.getElementById("music-widget");
        var songEl = document.getElementById("music-song");
        var artistEl = document.getElementById("music-artist");
        var metaEl = document.getElementById("music-meta");
        var artEl = document.getElementById("music-art");
        var artShell = widget ? widget.querySelector(".music-art-shell") : null;
        var audio = document.getElementById("music-audio");
        var playBtn = document.getElementById("music-play");
        var prevBtn = document.getElementById("music-prev");
        var nextBtn = document.getElementById("music-next");
        var progressEl = document.getElementById("music-progress");
        var timeEl = document.getElementById("music-time");

        var isOpen = false;
        var currentIndex = 0;
        var isPlaying = false;
        var wasPlayingBeforeSeek = false;

        if (!playlist || !playlist.length) {
            if (songEl) songEl.textContent = "No tracks";
            return;
        }

        function formatTime(sec) {
            if (!isFinite(sec)) return "0:00";
            var m = Math.floor(sec / 60);
            var s = Math.floor(sec % 60);
            return m + ":" + (s < 10 ? "0" + s : s);
        }

        function clearArtwork() {
            if (!artEl) return;
            artEl.onload = null;
            artEl.onerror = null;
            artEl.style.display = "none";
            artEl.removeAttribute("src");
            if (artShell) artShell.classList.remove("has-art");
        }

        function setArtwork(url) {
            if (!artEl) return;
            clearArtwork();
            if (!url) return;
            var img = new Image();
            img.onload = function () {
                if (!artEl) return;
                artEl.src = url;
                artEl.style.display = "block";
                if (artShell) artShell.classList.add("has-art");
            };
            img.onerror = function () {
                clearArtwork();
            };
            img.src = url;
        }

        function loadTrack(index) {
            currentIndex =
                ((index % playlist.length) + playlist.length) % playlist.length;
            var track = playlist[currentIndex];
            if (audio) audio.src = track.src;
            if (songEl) songEl.textContent = track.title || "Untitled";
            if (artistEl)
                artistEl.textContent =
                    (track.artist || "Unknown") +
                    (track.album ? " — " + track.album : "");
            if (metaEl)
                metaEl.textContent =
                    "Track " + (currentIndex + 1) + " / " + playlist.length;
            setArtwork(track.cover || "");
            if (progressEl) {
                progressEl.value = 0;
                progressEl.style.setProperty("--progress", "0%");
            }
            if (timeEl) timeEl.textContent = "0:00 / 0:00";
            isPlaying = false;
            updatePlayButton();
        }

        function updatePlayButton() {
            if (!playBtn) return;
            playBtn.textContent = isPlaying ? "⏸" : "▶";
            playBtn.setAttribute("aria-label", isPlaying ? "Pause" : "Play");
        }

        function togglePlay() {
            if (!audio) return;
            if (audio.paused || audio.ended) {
                audio.play().catch(function () {});
            } else {
                audio.pause();
            }
        }

        function updateProgress() {
            if (!audio || !progressEl || !timeEl) return;
            var dur = audio.duration || 0;
            var cur = audio.currentTime || 0;
            var pct = dur ? (cur / dur) * 100 : 0;
            progressEl.value = pct;
            progressEl.style.setProperty("--progress", pct.toFixed(1) + "%");
            timeEl.textContent = formatTime(cur) + " / " + formatTime(dur);
        }

        function seekFromInput() {
            if (!audio || !progressEl) return;
            var dur = audio.duration || 0;
            if (!dur) return;
            var pct = parseFloat(progressEl.value);
            audio.currentTime = (pct / 100) * dur;
            progressEl.style.setProperty("--progress", pct.toFixed(1) + "%");
        }

        function prevTrack() {
            loadTrack(currentIndex - 1);
            if (isPlaying && audio) audio.play().catch(function () {});
        }

        function nextTrack() {
            loadTrack(currentIndex + 1);
            if (isPlaying && audio) audio.play().catch(function () {});
        }

        if (audio) {
            audio.addEventListener("play", function () {
                isPlaying = true;
                updatePlayButton();
            });
            audio.addEventListener("pause", function () {
                isPlaying = false;
                updatePlayButton();
            });
            audio.addEventListener("ended", function () {
                nextTrack();
                if (audio) audio.play().catch(function () {});
            });
            audio.addEventListener("timeupdate", updateProgress);
            audio.addEventListener("loadedmetadata", updateProgress);
        }

        if (playBtn) playBtn.addEventListener("click", togglePlay);
        if (prevBtn) prevBtn.addEventListener("click", prevTrack);
        if (nextBtn) nextBtn.addEventListener("click", nextTrack);

        if (progressEl) {
            progressEl.addEventListener("mousedown", function () {
                wasPlayingBeforeSeek = isPlaying;
                if (audio) audio.pause();
            });
            progressEl.addEventListener("input", function () {
                seekFromInput();
            });
            progressEl.addEventListener("change", function () {
                seekFromInput();
                if (wasPlayingBeforeSeek && audio)
                    audio.play().catch(function () {});
            });
        }

        var navMusicBtn = document.getElementById("music-btn");
        if (navMusicBtn) {
            navMusicBtn.addEventListener("click", function (e) {
                e.preventDefault();
                isOpen ? closeWidget() : openWidget();
            });
        }

        function openWidget() {
            isOpen = true;
            widget.classList.remove("hidden");
            // rAF ensures the browser registers the unhidden state before
            // adding "visible", so the CSS transition actually fires
            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    widget.classList.add("visible");
                    widget.setAttribute("aria-hidden", "false");
                });
            });
        }

        function closeWidget() {
            isOpen = false;
            widget.classList.remove("visible");
            widget.setAttribute("aria-hidden", "true");
            // wait for fade-out transition before hiding from layout
            widget.addEventListener("transitionend", function handler(e) {
                if (e.propertyName !== "opacity") return;
                widget.classList.add("hidden");
                widget.removeEventListener("transitionend", handler);
            });
        }

        window.addEventListener("keydown", function (e) {
            if (e.key === "ArrowUp" && !isOpen) {
                e.preventDefault();
                openWidget();
            }
            if (e.key === "Escape" && isOpen) {
                closeWidget();
            }
            if (e.key === "ArrowDown" && isOpen) {
                e.preventDefault();
                closeWidget();
            }
            if (e.key === " " && isOpen) {
                e.preventDefault();
                togglePlay();
            }
        });

        document.addEventListener("click", function (e) {
            if (!widget) return;
            var inside = widget.contains(e.target);
            var clickedNav = navMusicBtn && navMusicBtn.contains(e.target);
            if (isOpen && !inside && !clickedNav) closeWidget();
        });

        loadTrack(0);
    })();
</script>

<style>
    #music-widget {
        transform: translate3d(1.75rem, 1rem, 0) scale(0.98);
        transition:
            opacity 0.34s ease,
            transform 0.38s ease;
    }

    #music-widget.visible {
        opacity: 1;
        transform: translate3d(0, 0, 0) scale(1);
        pointer-events: auto;
    }

    #music-widget.hidden {
        opacity: 0;
        pointer-events: none;
    }

    .music-shell {
        background:
            linear-gradient(
                145deg,
                rgba(232, 160, 168, 0.12),
                rgba(168, 200, 216, 0.03) 48%,
                rgba(255, 255, 255, 0.02)
            ),
            rgba(13, 14, 24, 0.88);
    }

    .music-orb {
        position: absolute;
        border-radius: 9999px;
        filter: blur(8px);
        opacity: 0.7;
        pointer-events: none;
    }

    .music-orb--pink {
        top: -1.25rem;
        right: 2.25rem;
        width: 6.5rem;
        height: 6.5rem;
        background: radial-gradient(
            circle,
            rgba(232, 160, 168, 0.2) 0%,
            rgba(232, 160, 168, 0) 72%
        );
    }

    .music-orb--cyan {
        bottom: -2rem;
        left: -1.5rem;
        width: 7rem;
        height: 7rem;
        background: radial-gradient(
            circle,
            rgba(168, 200, 216, 0.15) 0%,
            rgba(168, 200, 216, 0) 70%
        );
    }

    .music-art-link {
        display: block;
        border-radius: 1.15rem;
        transition: transform 0.2s ease;
    }

    .music-art-link:hover {
        transform: translateY(-1px);
    }

    .music-art-shell.has-art .music-art-fallback {
        opacity: 0;
    }

    .music-art-fallback,
    .music-art-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .music-art-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        background:
            linear-gradient(
                135deg,
                rgba(232, 160, 168, 0.16),
                rgba(155, 127, 184, 0.12) 45%,
                rgba(168, 200, 216, 0.12)
            ),
            rgba(22, 24, 40, 0.95);
        transition: opacity 0.2s ease;
    }

    .music-art-image {
        object-fit: cover;
    }

    .music-control-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.6rem;
        height: 1.6rem;
        border-radius: 0.45rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.04);
        color: rgba(241, 245, 249, 0.55);
        font-size: 0.7rem;
        line-height: 1;
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 0;
    }

    .music-control-btn:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--accent-pink, #e8a0a8);
        border-color: rgba(232, 160, 168, 0.25);
    }

    .music-control-btn--primary {
        width: 1.85rem;
        height: 1.85rem;
        font-size: 0.85rem;
        background: rgba(232, 160, 168, 0.12);
        border-color: rgba(232, 160, 168, 0.22);
        color: rgba(241, 245, 249, 0.85);
    }

    .music-control-btn--primary:hover {
        background: rgba(232, 160, 168, 0.22);
        color: #fff;
    }

    /* Progress bar with dynamic fill via --progress CSS var */
    .music-progress {
        -webkit-appearance: none;
        appearance: none;
        height: 3px;
        border-radius: 2px;
        outline: none;
        cursor: pointer;
        background: linear-gradient(
            to right,
            var(--accent-pink, #e8a0a8) 0%,
            var(--accent-pink, #e8a0a8) var(--progress, 0%),
            rgba(255, 255, 255, 0.1) var(--progress, 0%),
            rgba(255, 255, 255, 0.1) 100%
        );
    }

    .music-progress::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent-pink, #e8a0a8);
        cursor: pointer;
        border: none;
        transition: transform 0.15s ease;
    }

    .music-progress::-webkit-slider-thumb:hover {
        transform: scale(1.25);
    }

    .music-progress::-moz-range-thumb {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent-pink, #e8a0a8);
        cursor: pointer;
        border: none;
    }

    .music-progress::-moz-range-track {
        height: 3px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 2px;
    }

    @media (max-width: 640px) {
        #music-widget {
            transform: translate3d(0, 1rem, 0) scale(0.98);
        }

        #music-widget.visible {
            transform: translate3d(0, 0, 0) scale(1);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #music-widget,
        .music-art-link,
        .music-art-fallback,
        .music-control-btn {
            transition: none;
            animation: none;
        }
    }
</style>
