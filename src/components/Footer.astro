---
import { META } from '../data/index';
const currentYear = new Date().getFullYear();
---

<footer style="border-top: 1px solid rgba(255,255,255,0.07); padding-top: 2rem; padding-bottom: 2rem;">
  <div class="content-container">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-0 text-center sm:text-left">
      
      <!-- Left: Name -->
      <p class="font-['Inter'] text-[0.8rem] tracking-[0.2em] uppercase text-[rgba(241,245,249,0.4)]">
        {META.name}
      </p>

      <!-- Center: Tagline -->
      <p class="font-['JetBrains_Mono'] text-[0.7rem] text-[rgba(241,245,249,0.25)] tracking-[0.05em]">
        built with curiosity & too much coffee ☕
      </p>

      <!-- Right: Copyright -->
      <p class="font-['JetBrains_Mono'] text-[0.7rem] text-[rgba(241,245,249,0.25)] tracking-[0.05em]">
        &copy; {currentYear}
      </p>

    </div>
  </div>
</footer>
