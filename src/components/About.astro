---
import {META} from '../data/index';
---

<section id="about" style="padding: 5rem 1.5rem;">
  <div class="content-container">

    <span class="section-label animate-on-scroll">// about</span>
    <h2 class="section-heading animate-on-scroll">About Me</h2>

    <div class="about-grid animate-on-scroll delay-1">

      <!-- Left: Bio + Buttons -->
      <div class="bio">
        <p class="bio-text">
          I'm a passionate AI/ML engineer and computer science student
          deeply interested in building intelligent systems. With a strong
          foundation in deep learning, NLP, and computer vision,
          I'm driven to solve real-world problems using cutting-edge AI.
        </p>
        <p class="bio-text">
          Whether it's fine-tuning large language models, building RAG pipelines,
          or optimizing neural networks, I love pushing the boundaries of what's
          possible with AI. Currently seeking internship opportunities.
        </p>

        <!-- Buttons -->
        <div class="btn-row">
          <a href="/resume.pdf" target="_blank" class="btn-primary">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
            Resume
          </a>
          <a href={META.github} target="_blank" rel="noopener noreferrer" class="btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            GitHub
          </a>
          <a href={META.linkedin} target="_blank" rel="noopener noreferrer" class="btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>

      <!-- Right: Info + Discord status -->
      <div class="info-col">

        <!-- Discord status card -->
        <div class="discord-card">
          <div class="discord-top">
            <span class="discord-label">// Discord</span>
            <span class="discord-status">
              <span class="discord-dot"></span>
              <span id="discord-status-text">Offline</span>
            </span>
          </div>
          <p class="discord-user">{META.discord}</p>
          <p class="discord-activity" id="discord-activity">no current activity</p>
        </div>

        <div class="info-divider"></div>

        <div class="info-block">
          <span class="info-key">Location</span>
          <span class="info-val">{META.location}</span>
        </div>

        <div class="info-divider"></div>

        <div class="info-block">
          <span class="info-key">Status</span>
          <span class="info-val status">
            <span class="status-dot"></span>
            {META.available ? 'Available for internships' : 'Not available'}
          </span>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  // Lanyard API
  const DISCORD_USER_ID = '328694743057825792';

  async function fetchDiscordStatus() {
    try {
      const res = await fetch(`https://api.lanyard.rest/v1/users/${DISCORD_USER_ID}`);
      const data = await res.json();

      if (!data.success) return;

      const { discord_status, activities } = data.data;

      // Status dot color
      const dot = document.querySelector('.discord-dot') as HTMLElement;
      const statusText = document.getElementById('discord-status-text');
      const activityEl = document.getElementById('discord-activity');

      const colors: Record<string, string> = {
        online: '#57F287',
        idle: '#FEE75C',
        dnd: '#ED4245',
        offline: 'rgba(255,255,255,0.2)',
      };

      if (dot) dot.style.background = colors[discord_status] ?? colors.offline;
      if (statusText) statusText.textContent = discord_status === 'dnd' ? 'do not disturb' : discord_status;

      // Activity
      const activity = activities?.find((a: any) => a.type === 0);
      if (activityEl) {
        activityEl.textContent = activity
          ? `playing ${activity.name}`
          : activities?.[0]?.state ?? 'no current activity';
      }
    } catch (e) {
      // silently fail — offline state remains
    }
  }

  fetchDiscordStatus();
  setInterval(fetchDiscordStatus, 30000); // refresh every 30s
</script>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: start;
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bio-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    line-height: 1.8;
    color: rgba(240,232,224,0.55);
  }

  /* Buttons */
  .btn-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.1rem;
    background: var(--text-primary);
    color: var(--bg-base);
    border-radius: 999px;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .btn-primary:hover { opacity: 0.85; }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.1rem;
    background: transparent;
    color: var(--text-primary);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.3s ease, opacity 0.3s ease;
    opacity: 0.7;
  }

  .btn-ghost:hover {
    border-color: rgba(255,255,255,0.3);
    opacity: 1;
  }

  /* Discord card */
  .discord-card {
    padding: 1rem 0 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .discord-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }

  .discord-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: rgba(240,232,224,0.3);
    text-transform: uppercase;
  }

  .discord-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(240,232,224,0.4);
  }

  .discord-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    flex-shrink: 0;
    transition: background 0.3s ease;
  }

  .discord-user {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .discord-activity {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: rgba(240,232,224,0.3);
    letter-spacing: 0.03em;
  }

  /* Info rows */
  .info-col {
    display: flex;
    flex-direction: column;
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0.9rem 0;
  }

  .info-key {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240,232,224,0.3);
  }

  .info-val {
    font-family: 'Inter', sans-serif;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .info-divider {
    height: 1px;
    background: rgba(255,255,255,0.05);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-pink);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-pink);
    animation: pulse-ring 2s infinite;
    flex-shrink: 0;
  }
</style>