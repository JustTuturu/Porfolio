---
import { META } from '../data/index';

const currentYear = new Date().getFullYear();
---

<footer class="bg-bg-base border-t border-glass-border py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <!-- Branding -->
      <div class="animate-on-scroll">
        <h3 class="text-lg font-bold text-text-primary mb-2 font-heading">{META.name}</h3>
        <p class="text-sm text-text-muted">{META.role}</p>
        <p class="text-xs text-text-muted mt-2">{META.location}</p>
      </div>

      <!-- Links -->
      <div class="animate-on-scroll delay-1">
        <h4 class="text-sm font-mono text-accent-blue mb-4">Navigation</h4>
        <div class="space-y-2">
          <a href="#about" class="block text-sm text-text-muted hover:text-accent-blue transition-colors">
            About
          </a>
          <a href="#skills" class="block text-sm text-text-muted hover:text-accent-blue transition-colors">
            Skills
          </a>
          <a href="#projects" class="block text-sm text-text-muted hover:text-accent-blue transition-colors">
            Projects
          </a>
          <a href="#contact" class="block text-sm text-text-muted hover:text-accent-blue transition-colors">
            Contact
          </a>
        </div>
      </div>

      <!-- Social -->
      <div class="animate-on-scroll delay-2">
        <h4 class="text-sm font-mono text-accent-blue mb-4">Connect</h4>
        <div class="space-y-2">
          <a href={META.github} target="_blank" class="block text-sm text-text-muted hover:text-accent-blue transition-colors">
            GitHub
          </a>
          <a href={META.linkedin} target="_blank" class="block text-sm text-text-muted hover:text-accent-blue transition-colors">
            LinkedIn
          </a>
          <a href={`mailto:${META.email}`} class="block text-sm text-text-muted hover:text-accent-blue transition-colors">
            Email
          </a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-glass-border my-8"></div>

    <!-- Bottom -->
    <div class="flex flex-col md:flex-row items-center justify-between text-xs text-text-muted">
      <p>
        &copy; {currentYear} {META.name}. All rights reserved.
      </p>
      <p class="mt-4 md:mt-0">
        Built with <span class="text-accent-pink">Astro</span> + <span class="text-accent-blue">Tailwind CSS</span>
      </p>
    </div>
  </div>
</footer>

<style>
  footer {
    scroll-snap-type: none;
  }
</style>
