---
import { SKILLS } from '../data/index.ts';
---

<section id="skills" class="section-padding overflow-hidden">
  <div class="content-container">
    <!-- Section label -->
    <span class="section-label animate-on-scroll">// SKILLS</span>
    
    <!-- Section heading -->
    <h2 class="section-heading animate-on-scroll">
      Tech Stack
    </h2>

    <!-- Skills marquee container -->
    <div class="relative animate-on-scroll delay-1">
      <!-- Fade edges -->
      <div class="fade-edge fade-left"></div>
      <div class="fade-edge fade-right"></div>

      <!-- Scrolling track: duplicated group for seamless loop -->
      <div class="skills-track">
        <div class="skills-group">
          {SKILLS.map(({ name, icon }) => (
            <div class="tech-item">
              <img src={icon} alt={name} />
              <span>{name}</span>
            </div>
          ))}
        </div>
        <!-- Duplicate for seamless loop -->
        <div class="skills-group" aria-hidden="true">
          {SKILLS.map(({ name, icon }) => (
            <div class="tech-item">
              <img src={icon} alt={name} />
              <span>{name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .fade-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }
  
  .fade-left {
    left: 0;
    background: linear-gradient(to right, var(--bg-surface), transparent);
  }
  
  .fade-right {
    right: 0;
    background: linear-gradient(to left, var(--bg-surface), transparent);
  }

  /* Scrolling row */
  .skills-track {
    display: flex;
    width: max-content;
    animation: scroll-left 30s linear infinite;
  }

  /* Pause on hover */
  .skills-track:hover {
    animation-play-state: paused;
  }

  .skills-group {
    display: flex;
    align-items: center;
    gap: 3rem;
    padding-right: 3rem;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    opacity: 0.6;
    transition: opacity 0.3s ease;
    cursor: default;
    user-select: none;
  }

  .tech-item:hover {
    opacity: 1;
  }

  .tech-item img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    filter: grayscale(1) brightness(1.4);
  }

  .tech-item span {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: 0.1em;
  }

  /* The core animation: slides exactly 50% (one full copy) */
  @keyframes scroll-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .skills-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      padding: 0 2rem;
      gap: 1.5rem;
    }
    .skills-group:last-child { display: none; }
    .fade-edge { display: none; }
  }

  /* Mobile adjustments */
  @media (max-width: 767px) {
    .skills-group {
      gap: 2rem;
      padding-right: 2rem;
    }
    
    .fade-edge {
      width: 50px;
    }
  }
</style>
