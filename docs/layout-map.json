{
  "_meta": {
    "url": "https://justtuturu.dev",
    "framework": "Astro + Tailwind CSS",
    "viewport": "Responsive (mobile-first)",
    "theme": "Dark mode only",
    "lastUpdated": "2025-05-05"
  },
  "colorScheme": {
    "bgBase": "#0a0b14 (deep navy/black)",
    "bgCard": "rgba(22, 24, 40, 0.6)",
    "textPrimary": "rgba(241, 245, 249, ~0.9)",
    "textMuted": "rgba(240, 232, 224, 0.6)",
    "accentPink": "#E8A0A8",
    "accentPurple": "rgba(196, 168, 200, 0.3)",
    "accentBlue": "rgba(139, 174, 200, 0.3)",
    "glassBorder": "rgba(196, 168, 200, 0.12)",
    "cardBorder": "rgba(255, 255, 255, 0.08)"
  },
  "typography": {
    "heroTitle": "Space Grotesk, 48-96px, bold, white",
    "heroSubtitle": "Space Grotesk, large",
    "sectionHeading": "Space Grotesk / similar, bold",
    "body": "Inter, 0.8-1rem",
    "mono": "JetBrains Mono, 0.58-0.72rem, tracking wide, uppercase for labels"
  },
  "zIndex": {
    "navbar": 50,
    "musicWidget": 100,
    "sectionNav": 40
  },
  "layout": {
    "sections": [
      {
        "id": "navbar",
        "name": "Main Navigation",
        "component": "src/components/Navbar.astro",
        "position": "fixed top-0 left-0 right-0",
        "height": "~64px",
        "zIndex": 50,
        "items": [
          { "label": "TUT (Home)", "position": "left", "href": "/" },
          { "label": "ABOUT", "position": "center-left" },
          { "label": "PROJECTS", "position": "center" },
          { "label": "CONTACT", "position": "center-right" },
          { "label": "Music icon", "position": "right", "id": "music-btn", "action": "toggle MusicWidget" }
        ],
        "style": "backdrop-blur, transparent bg, text-white opacity hover"
      },
      {
        "id": "section-nav",
        "name": "Section Dot Navigation",
        "component": "src/components/SectionNav.astro (inferred)",
        "position": "fixed right-side, vertically centered",
        "zIndex": 40,
        "items": ["Hero", "About", "Projects", "Education"],
        "style": "Vertical dots, accent-pink active state"
      },
      {
        "id": "hero",
        "name": "Hero Section",
        "component": "src/components/Hero.astro",
        "position": "100vh, first viewport",
        "layout": "Centered text, large typography",
        "elements": [
          { "type": "heading", "text": "AI/ML", "size": "text-5xl sm:text-6xl md:text-8xl", "font": "font-jp (Japanese-style font)" },
          { "type": "heading", "text": "Tut", "size": "large", "style": "Bold, white" },
          { "type": "paragraph", "text": "LLM Fine-Tuning Enthusiast...", "style": "Muted, smaller" },
          { "type": "paragraph", "text": "Crafting intelligent systems...", "style": "Muted" },
          { "type": "cta", "text": "View my work", "href": "#projects" }
        ]
      },
      {
        "id": "about",
        "name": "About Section",
        "component": "src/components/About.astro",
        "position": "After hero, full width",
        "label": "// ABOUT (section label, JetBrains Mono, accent-pink)",
        "heading": "About Me",
        "content": [
          "CS student who loves building AI systems...",
          "Still learning, always building..."
        ],
        "subComponents": {
          "quickLinks": [
            { "text": "Resume", "href": "resume link" },
            { "text": "Email", "href": "mailto:justtuturu@gmail.com" },
            { "text": "LinkedIn", "href": "https://linkedin.com/in/teriyumi" },
            { "text": "X", "href": "https://x.com/justuturu" },
            { "text": "GitHub", "href": "https://github.com/justtuturu" }
          ],
          "discordStatus": {
            "label": "// DISCORD",
            "status": "DO NOT DISTURB",
            "username": "suzu / TutTutTut",
            "avatar": "Discord avatar for 328694743057825792"
          },
          "location": {
            "label": "LOCATION",
            "value": "Ho Chi Minh City, Vietnam"
          },
          "status": {
            "label": "STATUS",
            "value": "Available for internships"
          }
        }
      },
      {
        "id": "projects",
        "name": "Projects Section",
        "component": "src/components/Projects.astro",
        "position": "After about, full width",
        "label": "// PROJECTS",
        "heading": "Featured Projects",
        "dataSource": "src/data/index.ts → PROJECTS array",
        "layout": "1 featured card (large) + 2 smaller cards below",
        "cards": [
          {
            "featured": true,
            "category": "Multimodal ML",
            "categoryColor": "#E8A0A8",
            "title": "CLIP-BERT Multi-Label Classifier",
            "description": "Multi-label image classification combining CLIP + BERT...",
            "metrics": ["3 Architectures", "Label GCN", "t-SNE/PCA Viz"],
            "tech": ["Python", "PyTorch", "CLIP", "BERT", "Streamlit"],
            "github": "https://github.com/JustTuturu/mage-Classification-with-CLIP-and-BERT"
          },
          {
            "featured": false,
            "category": "LLM App",
            "categoryColor": "rgba(168, 200, 216, 0.82)",
            "title": "AI English Tutor",
            "description": "Conversational AI tutor for IELTS...",
            "metrics": ["IELTS Band 1-9", "One-Shot Prompting", "Voice AI"],
            "tech": ["Python", "OpenAI API", "ElevenLabs", "FastAPI"],
            "github": "https://github.com/JustTuturu/AI-English-Tutor-NLP-Project"
          },
          {
            "featured": false,
            "category": "Computer Vision",
            "categoryColor": "rgba(212, 149, 106, 0.78)",
            "title": "YOLOv10 Fruit Detector",
            "description": "Fine-tuned YOLOv10 on custom fruit dataset...",
            "metrics": ["YOLOv10 SOTA", "Custom Dataset", "Streamlit UI"],
            "tech": ["Python", "PyTorch", "YOLOv10", "Streamlit"],
            "github": "https://github.com/JustTuturu/Yolov10-CustomDataset"
          }
        ]
      },
      {
        "id": "education",
        "name": "Education Section",
        "component": "src/components/Education.astro",
        "position": "After projects, full width",
        "label": "// EDUCATION",
        "heading": "Education & Certifications",
        "dataSource": "src/data/index.ts → EDUCATION + CERTIFICATIONS",
        "layout": "Two columns: Degree (left) + Certifications (right)",
        "degree": {
          "university": "HCMUS University of Science",
          "degree": "Bachelor of Science — Information Technology",
          "graduation": "October 2025",
          "gpa": "3.0/ 4.0",
          "courses": ["Machine Learning", "NLP", "Data Structures & Algorithms", "Computer Vision"]
        },
        "certifications": [
          { "name": "Machine Learning by Andrew Ng", "platform": "Coursera", "date": "Aug 2023" },
          { "name": "Google AI Essential", "platform": "Google", "date": "August 2024", "url": "coursera link" }
        ]
      },
      {
        "id": "contact",
        "name": "Contact Section",
        "component": "src/components/Contact.astro",
        "position": "After education, full width",
        "label": "// CONTACT",
        "heading": "Get In Touch",
        "description": "Open to internships and collaborations. Just say hi.",
        "links": [
          { "label": "EMAIL", "value": "justtuturu@gmail.com", "href": "mailto:..." },
          { "label": "GITHUB", "value": "@justtuturu", "href": "https://github.com/justtuturu" },
          { "label": "LINKEDIN", "value": "@justtuturu", "href": "https://linkedin.com/in/teriyumi" }
        ]
      },
      {
        "id": "footer",
        "name": "Footer",
        "component": "src/components/Footer.astro",
        "position": "Bottom of page",
        "content": [
          "TUT",
          "built with curiosity & too much coffee ☕",
          "© 2026"
        ],
        "style": "Centered, small muted text, JetBrains Mono"
      }
    ],
    "overlays": [
      {
        "id": "music-widget",
        "name": "Music Player Widget",
        "component": "src/components/MusicWidget.astro",
        "position": "fixed top-16 right-4",
        "size": "w-[min(21.5rem, calc(100vw-1.5rem))]",
        "zIndex": 100,
        "trigger": "music-btn in navbar or ArrowUp key",
        "features": ["Play/Pause", "Prev/Next", "Seek bar", "Album art", "Track info"],
        "dataSource": "src/data/playlist.ts"
      }
    ]
  },
  "fileStructure": {
    "pages": "src/pages/index.astro (single page)",
    "layouts": "src/layouts/BaseLayout.astro",
    "components": [
      "src/components/Navbar.astro",
      "src/components/Hero.astro",
      "src/components/About.astro",
      "src/components/Projects.astro",
      "src/components/Education.astro",
      "src/components/Contact.astro",
      "src/components/Footer.astro",
      "src/components/MusicWidget.astro"
    ],
    "data": [
      "src/data/index.ts (META, ROLES, SITE, PROJECTS, EDUCATION, CERTIFICATIONS, EXPERIENCES)",
      "src/data/playlist.ts (music tracks)"
    ],
    "styles": "src/styles/global.css (CSS variables, custom utilities)",
    "config": "astro.config.mjs, tailwind.config"
  },
  "commonCSSPatterns": {
    "sectionLabel": "font-['JetBrains_Mono'] text-[0.65rem] tracking-[0.2em] uppercase text-[var(--accent-pink)]",
    "card": "rounded-[28px] border border-white/8 bg-[rgba(13,14,24,0.88)] backdrop-blur-[22px] shadow",
    "glass": "bg-[rgba(22,24,40,0.6)] backdrop-blur border border-[var(--glass-border)]",
    "hoverLink": "transition-colors duration-300 hover:text-[var(--accent-pink)]"
  }
}
