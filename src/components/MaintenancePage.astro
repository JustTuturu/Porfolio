---
import { META, SITE } from '../data/index';
---

<main class="maintenance-shell">
  <div class="maintenance-noise" aria-hidden="true"></div>
  <div class="maintenance-orb maintenance-orb--pink" aria-hidden="true"></div>
  <div class="maintenance-orb maintenance-orb--cyan" aria-hidden="true"></div>

  <section class="maintenance-card" aria-labelledby="maintenance-title">
    <p class="maintenance-kicker">// maintenance</p>
    <h1 id="maintenance-title" class="maintenance-title">{SITE.maintenanceTitle}</h1>
    <p class="maintenance-copy">{SITE.maintenanceMessage}</p>

    <div class="maintenance-meta" aria-label="Status details">
      <div class="maintenance-meta-item">
        <span class="maintenance-meta-label">Status</span>
        <span class="maintenance-meta-value maintenance-meta-value--live">
          <span class="maintenance-dot" aria-hidden="true"></span>
          updating
        </span>
      </div>
      <div class="maintenance-meta-item">
        <span class="maintenance-meta-label">Owner</span>
        <span class="maintenance-meta-value">{META.name}</span>
      </div>
    </div>

    <p class="maintenance-footnote">Thank you for your patience.</p>
  </section>
</main>

<style>
  .maintenance-shell {
    position: relative;
    min-height: 100vh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 2rem;
    background:
      radial-gradient(circle at top, rgba(232, 160, 168, 0.08), transparent 30%),
      radial-gradient(circle at bottom left, rgba(168, 200, 216, 0.08), transparent 30%),
      var(--bg-base);
  }

  .maintenance-noise {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 36px 36px;
    pointer-events: none;
  }

  .maintenance-orb {
    position: absolute;
    border-radius: 9999px;
    filter: blur(20px);
    opacity: 0.7;
    pointer-events: none;
  }

  .maintenance-orb--pink {
    top: 10%;
    right: 12%;
    width: 14rem;
    height: 14rem;
    background: radial-gradient(circle, rgba(232, 160, 168, 0.24) 0%, rgba(232, 160, 168, 0) 70%);
  }

  .maintenance-orb--cyan {
    bottom: 8%;
    left: 10%;
    width: 12rem;
    height: 12rem;
    background: radial-gradient(circle, rgba(168, 200, 216, 0.18) 0%, rgba(168, 200, 216, 0) 72%);
  }

  .maintenance-card {
    position: relative;
    z-index: 1;
    width: min(100%, 38rem);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.75rem;
    padding: 2rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012)),
      rgba(13, 14, 24, 0.82);
    box-shadow: 0 28px 80px rgba(3, 4, 10, 0.45);
    backdrop-filter: blur(18px);
  }

  .maintenance-kicker {
    margin-bottom: 0.9rem;
    color: var(--accent-pink);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .maintenance-title {
    color: var(--text-primary);
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 0.98;
    margin-bottom: 1rem;
  }

  .maintenance-copy {
    max-width: 34rem;
    color: var(--text-muted);
    font-family: 'Inter', sans-serif;
    font-size: 0.98rem;
    line-height: 1.85;
  }

  .maintenance-meta {
    margin-top: 1.7rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .maintenance-meta-item {
    min-width: 9rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 0.7rem 0.95rem;
    background: rgba(255, 255, 255, 0.025);
  }

  .maintenance-meta-label {
    display: block;
    margin-bottom: 0.18rem;
    color: rgba(240, 232, 224, 0.34);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .maintenance-meta-value {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
  }

  .maintenance-meta-value--live {
    color: var(--accent-cyan);
  }

  .maintenance-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 9999px;
    background: var(--accent-cyan);
    box-shadow: 0 0 0 0 rgba(168, 200, 216, 0.45);
    animation: maintenance-pulse 1.8s infinite;
  }

  .maintenance-footnote {
    margin-top: 1.35rem;
    color: rgba(240, 232, 224, 0.42);
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
  }

  @keyframes maintenance-pulse {
    0% { box-shadow: 0 0 0 0 rgba(168, 200, 216, 0.45); }
    70% { box-shadow: 0 0 0 10px rgba(168, 200, 216, 0); }
    100% { box-shadow: 0 0 0 0 rgba(168, 200, 216, 0); }
  }

  @media (max-width: 640px) {
    .maintenance-shell {
      padding: 1rem;
    }

    .maintenance-card {
      border-radius: 1.45rem;
      padding: 1.35rem;
    }

    .maintenance-copy {
      font-size: 0.92rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .maintenance-dot {
      animation: none;
    }
  }
</style>
