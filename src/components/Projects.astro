---
import { PROJECTS } from '../data/index';

const featured = PROJECTS.find((p) => p.featured);
const others = PROJECTS.filter((p) => !p.featured);
---

<section id="projects" style="padding: 5rem 1.5rem;" aria-labelledby="projects-heading">
  <div class="content-container">

    <span class="section-label animate-on-scroll" id="projects-heading">// projects</span>
    <h2 class="section-heading animate-on-scroll">Featured Projects</h2>

    <!-- Featured project -->
    {featured && (
      <article class="border border-white/7 rounded-xl p-5 sm:p-8 mb-12 transition-[border-color] duration-300 hover:border-[var(--accent-pink)]/30 animate-on-scroll delay-1" aria-label="Featured project: {featured.title}">

        <div class="flex items-center justify-between mb-4">
          <span class="font-['JetBrains_Mono'] text-[0.65rem] tracking-[0.15em] uppercase" style={`color: ${featured.categoryColor};`}>
            {featured.category}
          </span>
          <span class="font-['JetBrains_Mono'] text-[0.65rem] text-[var(--text-primary)]/30 tracking-[0.1em]">{featured.label}</span>
        </div>

        <h3 class="font-['Space_Grotesk'] text-[1.4rem] font-bold text-[var(--text-primary)] mb-3 transition-colors duration-300 hover:text-[var(--accent-pink)]">{featured.title}</h3>
        <p class="font-['Inter'] text-[0.9rem] text-[var(--text-primary)]/50 leading-[1.7] mb-5">{featured.description}</p>

        <div class="flex flex-wrap gap-3 mb-4">
          {featured.metrics.map((m) => (
            <span class="font-['JetBrains_Mono'] text-[0.72rem] text-[var(--accent-cyan)] bg-[var(--accent-cyan)]/8 border border-[var(--accent-cyan)]/15 rounded px-2 py-0.5">{m}</span>
          ))}
        </div>

        <div class="flex flex-wrap gap-2 mb-5">
          {featured.tech.map((t) => (
            <span class="font-['JetBrains_Mono'] text-[0.65rem] text-[var(--text-primary)]/40 border border-white/7 rounded px-2 py-0.5">{t}</span>
          ))}
        </div>

        <div class="flex gap-6">
          {featured.github && (
            <a href={featured.github} target="_blank" rel="noopener noreferrer" class="font-['JetBrains_Mono'] text-[0.8rem] text-[var(--text-primary)]/50 no-underline transition-colors duration-300 hover:text-[var(--accent-pink)]" aria-label="View source code for {featured.title} (opens in new tab)">
              View Code →
            </a>
          )}
          {featured.demo && (
            <a href={featured.demo} target="_blank" rel="noopener noreferrer" class="font-['JetBrains_Mono'] text-[0.8rem] text-[var(--text-primary)]/50 no-underline transition-colors duration-300 hover:text-[var(--accent-pink)]" aria-label="View live demo for {featured.title} (opens in new tab)">
              Live Demo →
            </a>
          )}
        </div>

      </article>
    )}

    <!-- Other projects -->
    {others.length > 0 && (
      <>
        <p class="section-label animate-on-scroll mb-6" id="other-projects-label">Other Projects</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6" role="list" aria-labelledby="other-projects-label">
          {others.map((project, idx) => (
            <article class={`other-card animate-on-scroll delay-1-${Math.min(idx + 1, 4)} border border-white/7 rounded-xl p-6 flex flex-col gap-2.5 transition-[border-color] duration-300 hover:border-[var(--accent-pink)]/30`} role="listitem" aria-label="Project: {project.title}">

              <div class="flex items-center justify-between mb-4">
                <span class="font-['JetBrains_Mono'] text-[0.65rem] tracking-[0.15em] uppercase" style={`color: ${project.categoryColor};`}>
                  {project.category}
                </span>
                <span class="font-['JetBrains_Mono'] text-[0.65rem] text-[var(--text-primary)]/30 tracking-[0.1em]">{project.label}</span>
              </div>

              <h4 class="font-['Space_Grotesk'] text-[1rem] font-semibold text-[var(--text-primary)] transition-colors duration-300 hover:text-[var(--accent-pink)]">{project.title}</h4>
              <p class="font-['Inter'] text-[0.85rem] text-[var(--text-primary)]/50 leading-[1.7]">{project.description}</p>

              {project.metrics.length > 0 && (
                <p class="font-['JetBrains_Mono'] text-[0.7rem] text-[var(--accent-cyan)] mb-3 opacity-70">{project.metrics.join(' · ')}</p>
              )}

              <div class="flex flex-wrap gap-2 mb-5">
                {project.tech.map((t) => (
                  <span class="font-['JetBrains_Mono'] text-[0.65rem] text-[var(--text-primary)]/40 border border-white/7 rounded px-2 py-0.5">{t}</span>
                ))}
              </div>

              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" class="font-['JetBrains_Mono'] text-[0.75rem] text-[var(--text-primary)]/50 no-underline transition-colors duration-300 hover:text-[var(--accent-pink)]" aria-label="View source code for {project.title} (opens in new tab)">
                  View Code →
                </a>
              )}

            </article>
          ))}
        </div>
      </>
    )}

  </div>
</section>
