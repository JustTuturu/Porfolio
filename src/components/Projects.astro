---
import { PROJECTS } from '../data/index';

const featured = PROJECTS.find((p) => p.featured);
const others = PROJECTS.filter((p) => !p.featured);
---

<section id="projects" class="section-padding" aria-labelledby="projects-heading">
  <div class="content-container">

    <span class="section-label animate-on-scroll" id="projects-heading">// projects</span>
    <h2 class="section-heading animate-on-scroll">Featured Projects</h2>

    <div class="masonry-grid animate-on-scroll delay-1">

      <!-- Featured — tall card -->
      {featured && (
        <article class="masonry-featured overflow-hidden rounded-[0.875rem] border border-white/8 bg-white/[0.015] p-6 flex flex-col transition-[border-color,transform] duration-300 hover:-translate-y-[2px] hover:border-[var(--accent-pink)]/28 sm:p-8" aria-label={`Featured project: ${featured.title}`}>

          <div class="flex items-center justify-between mb-6">
            <span class="font-['JetBrains_Mono'] type-label-small uppercase" style={`color: ${featured.categoryColor};`}>
              {featured.category}
            </span>
            <span class="type-body-small text-[var(--text-primary)]/28 truncate max-w-[140px]">
              {featured.label}
            </span>
          </div>

          <div class="space-y-3 flex-1">
            <h3 class="font-['Space_Grotesk'] type-headline-small text-[var(--text-primary)] transition-colors duration-300 hover:text-[var(--accent-pink)]">
              {featured.title}
            </h3>
            <p class="type-body-medium text-[var(--text-primary)]/52">
              {featured.description}
            </p>
          </div>

          <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2">
            {featured.metrics.map((m) => (
              <span class="type-label-medium text-[var(--accent-cyan)]/88">{m}</span>
            ))}
          </div>

          <div class="mt-4 flex flex-wrap gap-x-3 gap-y-2">
            {featured.tech.map((t) => (
              <span class="type-body-small text-[var(--text-primary)]/40">{t}</span>
            ))}
          </div>

          <div class="mt-7 flex flex-wrap gap-5">
            {featured.github && (
              <a href={featured.github} target="_blank" rel="noopener noreferrer" class="type-label-medium text-[var(--text-primary)]/48 no-underline transition-colors duration-300 hover:text-[var(--accent-pink)]">
                View Code →
              </a>
            )}
            {featured.demo && (
              <a href={featured.demo} target="_blank" rel="noopener noreferrer" class="type-label-medium text-[var(--text-primary)]/48 no-underline transition-colors duration-300 hover:text-[var(--accent-pink)]">
                Live Demo →
              </a>
            )}
          </div>

        </article>
      )}

      <!-- Other projects — smaller cards -->
      {others.map((project, idx) => (
        <article class={`animate-on-scroll delay-1-${Math.min(idx + 1, 4)} overflow-hidden rounded-[0.75rem] border border-white/8 bg-white/[0.012] p-6 flex flex-col transition-[border-color,transform] duration-300 hover:-translate-y-[2px] hover:border-[var(--accent-pink)]/26`} aria-label={`Project: ${project.title}`}>

          <div class="flex items-center justify-between mb-5">
            <span class="font-['JetBrains_Mono'] type-label-small uppercase" style={`color: ${project.categoryColor};`}>
              {project.category}
            </span>
            <span class="type-body-small text-[var(--text-primary)]/26 truncate max-w-[100px]">
              {project.label}
            </span>
          </div>

          <div class="space-y-2 flex-1">
            <h4 class="font-['Space_Grotesk'] type-title-large text-[var(--text-primary)] transition-colors duration-300 hover:text-[var(--accent-pink)]">
              {project.title}
            </h4>
            <p class="type-body-medium text-[var(--text-primary)]/50">
              {project.description}
            </p>
          </div>

          {project.metrics.length > 0 && (
            <p class="mt-4 type-label-medium text-[var(--accent-cyan)]/82">
              {project.metrics.join(' · ')}
            </p>
          )}

          <div class="mt-4 flex flex-wrap gap-x-3 gap-y-2">
            {project.tech.map((t) => (
              <span class="type-body-small text-[var(--text-primary)]/40">{t}</span>
            ))}
          </div>

          {project.github && (
            <a href={project.github} target="_blank" rel="noopener noreferrer" class="mt-5 type-label-medium text-[var(--text-primary)]/48 no-underline transition-colors duration-300 hover:text-[var(--accent-pink)]">
              View Code →
            </a>
          )}

        </article>
      ))}

    </div>
  </div>
</section>

<style>
  .masonry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .masonry-grid {
      grid-template-columns: 1.4fr 1fr;
    }

    .masonry-featured {
      grid-row: span 2;
    }
  }
</style>
